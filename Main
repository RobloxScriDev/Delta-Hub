addSection("Players by Distance")

local function refreshFreeCamPlayers()
	if hubDestroyed then return end
	for _, child in ipairs(freeCamTab:GetChildren()) do
		if child:GetAttribute("FreeCamRow") then child:Destroy() end
	end
	local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	local players = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChild("Humanoid")
			if root and hum and hum.Health > 0 then
				local distance = myRoot and (myRoot.Position - root.Position).Magnitude * 0.28 or math.huge
				table.insert(players, {player=player, distance=distance, value=Inventory.getTotalValue(player)})
			end
		end
	end
	table.sort(players, function(a, b) return a.distance < b.distance end)
	for index, data in ipairs(players) do
		local row = Instance.new("TextButton", freeCamTab)
		row.Size = UDim2.new(1, -6, 0, 42)
		row.BackgroundColor3 = THEME.card
		row.BorderSizePixel = 0
		row.AutoButtonColor = false
		row.Text = string.format("%s  |  %.0f m  |  $%d", data.player.Name, data.distance, math.floor(data.value))
		row.TextColor3 = THEME.text
		row.Font = Enum.Font.GothamMedium
		row.TextSize = 13
		row.LayoutOrder = 20 + index
		row:SetAttribute("FreeCamRow", true)
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
		row.MouseEnter:Connect(function() row.BackgroundColor3 = THEME.cardHover end)
		row.MouseLeave:Connect(function() row.BackgroundColor3 = THEME.card end)
		row.MouseButton1Click:Connect(function()
			AdminTools.stopSpectating()
			Inventory.setPinnedPlayer(nil)
			if Freecam.startNearPlayer(data.player) then
				setMenuVisible(false)
				freeCamStatus.Text = "Freecam near: " .. data.player.Name
			end
		end)
	end
end

local freeCamRefreshElapsed = 0
RunService.Heartbeat:Connect(function(dt)
	if hubDestroyed then return end
	freeCamRefreshElapsed = freeCamRefreshElapsed + dt
	if freeCamRefreshElapsed >= 0.5 then
		freeCamRefreshElapsed = 0
		refreshFreeCamPlayers()
	end
end)
refreshFreeCamPlayers()

