local hubDestroyed     = false
local savedMouseBehavior = UserInputService.MouseBehavior
local savedMouseIconEnabled = UserInputService.MouseIconEnabled

-- HELPERS
local H = (function()
	local self = {}

	function self.isNPC(model)
		if not model or not model:IsA("Model") then return false end
		local hum  = model:FindFirstChild("Humanoid")
		local head = model:FindFirstChild("Head")
		local root = model:FindFirstChild("HumanoidRootPart")
		if not (hum and head and root) then return false end
		return Players:GetPlayerFromCharacter(model) == nil
	end

	function self.getHeldItemName(character)
		if not character then return nil end
		local tool = character:FindFirstChildOfClass("Tool")
		return tool and tool.Name or nil
	end

	function self.isAiming(character)
		if not character then return false end
		-- Different games replicate ADS state under different names. Prefer an
		-- explicit replicated flag instead of inferring it from where a model faces.
		for _, container in ipairs({character, character:FindFirstChildOfClass("Tool")}) do
			if container then
				for _, name in ipairs({"Aiming", "IsAiming", "Aim", "ADS", "IsADS"}) do
					if container:GetAttribute(name) == true then return true end
					local flag = container:FindFirstChild(name, true)
					if flag and flag:IsA("BoolValue") and flag.Value then return true end
				end
			end
		end
		return false
	end

	self.activeNPCs = {}
	local activeNPCSet = {}
	local function addNPC(model)
		if model and self.isNPC(model) and not activeNPCSet[model] then
			activeNPCSet[model] = true
			table.insert(self.activeNPCs, model)
		end
	end
	local function findAndAddNPCFrom(desc)
		local candidate = desc:IsA("Model") and desc or desc.Parent
		while candidate and candidate ~= Workspace do
			if candidate:IsA("Model") then addNPC(candidate) end
			candidate = candidate.Parent
		end
	end
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") then addNPC(obj) end
	end
	Workspace.DescendantAdded:Connect(function(desc)
		-- A model can be replicated before Humanoid, Head, or RootPart. Check its
		-- ancestors on every addition so it is registered as soon as it is complete.
		findAndAddNPCFrom(desc)
	end)
	Workspace.DescendantRemoving:Connect(function(desc)
		for i, npc in ipairs(self.activeNPCs) do
			if npc == desc then
				activeNPCSet[npc] = nil
				table.remove(self.activeNPCs, i)
				break
			end
		end
	end)

	function self.isVisible(targetPos, targetModel)
		if not targetPos or not targetModel then return false end
		local camPos = Camera.CFrame.Position
		local dir = (targetPos - camPos).Unit * 1000
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Blacklist
		local lc = LocalPlayer.Character
		params.FilterDescendantsInstances = lc and {lc} or {}
		local r = Workspace:Raycast(camPos, dir, params)
		if r then return r.Instance:IsDescendantOf(targetModel) end
		return true
	end

	function self.isDescendantOf(part, ancestor)
		if not ancestor then return false end
		local p = part
		while p do
			if p == ancestor then return true end
			p = p.Parent
		end
		return false
	end

	function self.getViewModel()
		for _, name in ipairs({"ViewModel", "Viewmodel", "viewmodel"}) do
			local vm = Camera:FindFirstChild(name)
			if vm then return vm end
		end
		return nil
	end

	function self.matchesHold(input)
		local hk = S.holdKey
		if hk.type == "key" then
			return input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == hk.code
		else
			return input.UserInputType == hk.code
		end
	end

	function self.holdKeyName() return S.holdKey.code.Name end

	return self
end)()

-- PLAYER ESP
local ESP = (function()
	local self = {}
	local drawings, skeletonDrawings, tracerDrawings = {}, {}, {}
	local espHeartbeat, skeletonHeartbeat, tracerHeartbeat
	local lastPlayerRefresh = 0

	local bones = {
		{"Head","UpperTorso"},{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},
		{"LeftLowerArm","LeftHand"},{"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},
		{"RightLowerArm","RightHand"},{"UpperTorso","LowerTorso"},{"LowerTorso","LeftUpperLeg"},
		{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},{"LowerTorso","RightUpperLeg"},
		{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"}
	}

	local function clearESP(plr)
		local ds = drawings[plr]
		if ds then
			ds.box:Remove(); ds.nameTag:Remove(); ds.distTag:Remove(); ds.heldItemTag:Remove(); ds.aimingTag:Remove(); ds.healthBar:Remove()
			drawings[plr] = nil
		end
	end
	local function clearSkel(plr)
		local d = skeletonDrawings[plr]
		if d then for _, l in ipairs(d.lines) do l:Remove() end; skeletonDrawings[plr] = nil end
	end
	local function clearTrc(plr)
		local l = tracerDrawings[plr]
		if l then l:Remove(); tracerDrawings[plr] = nil end
	end

	local function createESP(plr)
		local ds = {}
		ds.box = Drawing.new("Square")
		ds.box.Visible = false; ds.box.Color = C.ESP; ds.box.Thickness = 2; ds.box.Filled = false
		ds.nameTag = Drawing.new("Text")
		ds.nameTag.Visible = false; ds.nameTag.Color = Color3.new(1,1,1); ds.nameTag.Size = 14
		ds.nameTag.Center = true; ds.nameTag.Outline = true; ds.nameTag.OutlineColor = Color3.new(0,0,0)
		ds.distTag = Drawing.new("Text")
		ds.distTag.Visible = false; ds.distTag.Color = Color3.fromRGB(100,180,255); ds.distTag.Size = 13
		ds.distTag.Center = true; ds.distTag.Outline = true; ds.distTag.OutlineColor = Color3.new(0,0,0)
		ds.heldItemTag = Drawing.new("Text")
		ds.heldItemTag.Visible = false; ds.heldItemTag.Color = Color3.fromRGB(255, 220, 120); ds.heldItemTag.Size = 13
		ds.heldItemTag.Center = true; ds.heldItemTag.Outline = true; ds.heldItemTag.OutlineColor = Color3.new(0,0,0)
		ds.aimingTag = Drawing.new("Text")
		ds.aimingTag.Visible = false; ds.aimingTag.Color = Color3.fromRGB(255, 110, 110); ds.aimingTag.Size = 13
		ds.aimingTag.Center = true; ds.aimingTag.Outline = true; ds.aimingTag.OutlineColor = Color3.new(0,0,0)
		ds.healthBar = Drawing.new("Line")
		ds.healthBar.Visible = false; ds.healthBar.Thickness = 2
		drawings[plr] = ds
	end

	local function createSkel(plr)
		local lines = {}
		for _ = 1, 14 do
			local line = Drawing.new("Line")
			line.Visible = false; line.Color = C.SKELETON; line.Thickness = 1.5
			table.insert(lines, line)
		end
		skeletonDrawings[plr] = {lines = lines}
	end

	local function createTrc(plr)
		local line = Drawing.new("Line")
		line.Visible = false; line.Color = C.TRACER; line.Thickness = 1.5
		tracerDrawings[plr] = line
	end

	local function updateESPForTarget(plr, char, ds, isNPCModel)
		local head = char:FindFirstChild("Head")
		local root = char:FindFirstChild("HumanoidRootPart")
		local hum  = char:FindFirstChild("Humanoid")
		if not (head and root and hum) then
			ds.box.Visible = false; ds.nameTag.Visible = false
			ds.distTag.Visible = false; ds.heldItemTag.Visible = false; ds.aimingTag.Visible = false; ds.healthBar.Visible = false
			return
		end
		local top = head.Position + Vector3.new(0, 1.2, 0)
		local bottom = root.Position - Vector3.new(0, 2.8, 0)
		local topV, topOn = Camera:WorldToViewportPoint(top)
		local botV, botOn = Camera:WorldToViewportPoint(bottom)
		if not (topOn and botOn) or topV.Z <= 0 or botV.Z <= 0 then
			ds.box.Visible = false; ds.nameTag.Visible = false
			ds.distTag.Visible = false; ds.heldItemTag.Visible = false; ds.aimingTag.Visible = false; ds.healthBar.Visible = false
			return
		end
		local h = math.abs(botV.Y - topV.Y)
		local w = h * 0.5
		local pos = Vector2.new(topV.X - w/2, topV.Y)
		ds.box.Size = Vector2.new(w, h); ds.box.Position = pos; ds.box.Visible = true

		local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		local dist = myRoot and math.floor((myRoot.Position - root.Position).Magnitude * 0.28) or 0
		ds.nameTag.Position = Vector2.new(topV.X, pos.Y - 16)
		ds.nameTag.Visible = true
		local lootValue = Inventory and Inventory.getTotalValue and Inventory.getTotalValue(plr) or 0
		ds.nameTag.Text = string.format("%s | $%d | %d HP", plr.Name, math.floor(lootValue), math.floor(hum.Health))
		ds.distTag.Position = Vector2.new(topV.X, pos.Y - 30)
		ds.distTag.Visible = true
		ds.distTag.Text = dist .. "m"
		local nextTagY = pos.Y - 44
		local heldItem = S.espShowHeldItem and H.getHeldItemName(char)
		ds.heldItemTag.Visible = heldItem ~= nil
		if heldItem then
			ds.heldItemTag.Position = Vector2.new(topV.X, nextTagY)
			ds.heldItemTag.Text = "[" .. heldItem .. "]"
			nextTagY = nextTagY - 14
		end
		local aiming = S.espShowAiming and H.isAiming(char)
		ds.aimingTag.Visible = aiming
		if aiming then
			ds.aimingTag.Position = Vector2.new(topV.X, nextTagY)
			ds.aimingTag.Text = "[AIMING]"
		end

		local hp = hum.Health / hum.MaxHealth
		local barHeight = h * hp
		local barX = pos.X + w + 3
		local barTopY = pos.Y + h - barHeight
		ds.healthBar.From = Vector2.new(barX, barTopY)
		ds.healthBar.To = Vector2.new(barX, pos.Y + h)
		ds.healthBar.Color = hp > 0.5 and Color3.fromRGB(0,255,0) or hp > 0.25 and Color3.fromRGB(255,255,0) or Color3.fromRGB(255,0,0)
		ds.healthBar.Visible = true

		ds.box.Color = isNPCModel and C.NPC_ESP or C.ESP
	end

	local function updateSkeletonForTarget(char, lines, isNPCModel)
		local parts = {}
		for _, pair in ipairs(bones) do
			local p1 = char:FindFirstChild(pair[1])
			local p2 = char:FindFirstChild(pair[2])
			if p1 and p2 then
				parts[pair[1]] = p1; parts[pair[2]] = p2
			else
				for _, line in ipairs(lines) do line.Visible = false end
				return
			end
		end
		for i, pair in ipairs(bones) do
			local pos1 = Camera:WorldToViewportPoint(parts[pair[1]].Position)
			local pos2 = Camera:WorldToViewportPoint(parts[pair[2]].Position)
			local line = lines[i]
			if pos1.Z > 0 and pos2.Z > 0 then
				line.From = Vector2.new(pos1.X, pos1.Y)
				line.To = Vector2.new(pos2.X, pos2.Y)
				line.Visible = true
				line.Color = isNPCModel and C.NPC_SKELETON or C.SKELETON
			else
				line.Visible = false
			end
		end
	end

	local function updateTracerForTarget(char, root, line)
		local sw, sh = Camera.ViewportSize.X, Camera.ViewportSize.Y
		local lineStart = Vector2.new(sw / 2, sh)
		local screenCenter = Vector2.new(sw / 2, sh / 2)
		local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
		if pos.Z > 0 and onScreen then
			line.From = lineStart
			line.To = Vector2.new(pos.X, pos.Y)
		elseif pos.Z ~= 0 then
			local direction = Vector2.new(pos.X - screenCenter.X, pos.Y - screenCenter.Y)
			if pos.Z < 0 then direction = -direction end
			if direction.Magnitude == 0 then line.Visible = false; return end
			local halfW, halfH = sw / 2 - 12, sh / 2 - 12
			local scaleX = direction.X == 0 and math.huge or halfW / math.abs(direction.X)
			local scaleY = direction.Y == 0 and math.huge or halfH / math.abs(direction.Y)
			line.From = lineStart
			line.To = screenCenter + direction * math.min(scaleX, scaleY)
		else
			line.Visible = false
			return
		end
		line.Visible = true
		local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		local head = char:FindFirstChild("Head") or root
		local toLocal = localRoot and localRoot.Position - head.Position
		local isAimingAtYou = toLocal and toLocal.Magnitude > 0
			and head.CFrame.LookVector:Dot(toLocal.Unit) >= 0.97
		line.Color = isAimingAtYou and C.TRACER_TARGETING
			or (H.isVisible(root.Position, char) and C.TRACER or C.TRACER_HIDDEN)
	end

	local function refreshPlayers()
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				if S.espBox and not drawings[plr] then createESP(plr) end
				if S.espSkeleton and not skeletonDrawings[plr] then createSkel(plr) end
				if S.espTracer and not tracerDrawings[plr] then createTrc(plr) end
			end
		end
	end

	local function refreshPlayersPeriodically()
		if os.clock() - lastPlayerRefresh < 0.5 then return end
		lastPlayerRefresh = os.clock()
		refreshPlayers()
	end

	local function updateESP()
		refreshPlayersPeriodically()
		for plr, ds in pairs(drawings) do
			local char = plr.Character
			if char then updateESPForTarget(plr, char, ds, false)
			else
				ds.box.Visible = false; ds.nameTag.Visible = false
				ds.distTag.Visible = false; ds.heldItemTag.Visible = false; ds.aimingTag.Visible = false; ds.healthBar.Visible = false
			end
		end
	end
	local function updateSkel()
		refreshPlayersPeriodically()
		for plr, data in pairs(skeletonDrawings) do
			local char = plr.Character
			if char then updateSkeletonForTarget(char, data.lines, false)
			else for _, l in ipairs(data.lines) do l.Visible = false end end
		end
	end
	local function updateTrc()
		refreshPlayersPeriodically()
		for plr, line in pairs(tracerDrawings) do
			local char = plr.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if root then updateTracerForTarget(char, root, line)
			else line.Visible = false end
		end
	end

	function self.startESP()
		if espHeartbeat then espHeartbeat:Disconnect() end
		refreshPlayers()
		espHeartbeat = RunService.Heartbeat:Connect(updateESP)
	end
	function self.stopESP()
		if espHeartbeat then espHeartbeat:Disconnect(); espHeartbeat = nil end
		for plr in pairs(drawings) do clearESP(plr) end
	end
	function self.startSkeleton()
		if skeletonHeartbeat then skeletonHeartbeat:Disconnect() end
		refreshPlayers()
		skeletonHeartbeat = RunService.Heartbeat:Connect(updateSkel)
	end
	function self.stopSkeleton()
		if skeletonHeartbeat then skeletonHeartbeat:Disconnect(); skeletonHeartbeat = nil end
		for plr in pairs(skeletonDrawings) do clearSkel(plr) end
	end
	function self.startTracer()
		if tracerHeartbeat then tracerHeartbeat:Disconnect() end
		refreshPlayers()
		tracerHeartbeat = RunService.Heartbeat:Connect(updateTrc)
	end
	function self.stopTracer()
		if tracerHeartbeat then tracerHeartbeat:Disconnect(); tracerHeartbeat = nil end
		for plr in pairs(tracerDrawings) do clearTrc(plr) end
	end

	function self.setBox(on) S.espBox = on; if on then self.startESP() else self.stopESP() end end
	function self.setSkeleton(on) S.espSkeleton = on; if on then self.startSkeleton() else self.stopSkeleton() end end
	function self.setTracer(on) S.espTracer = on; if on then self.startTracer() else self.stopTracer() end end

	function self.createESP(plr) createESP(plr) end
	function self.createSkeleton(plr) createSkel(plr) end
	function self.createTracer(plr) createTrc(plr) end
	function self.clearESP(plr) clearESP(plr) end
	function self.clearSkeleton(plr) clearSkel(plr) end
	function self.clearTracer(plr) clearTrc(plr) end
	function self.refresh() refreshPlayers() end
	function self.restartAll()
		if S.espBox then self.stopESP(); self.startESP() end
		if S.espSkeleton then self.stopSkeleton(); self.startSkeleton() end
		if S.espTracer then self.stopTracer(); self.startTracer() end
	end

	return self
end)()

-- NPC ESP
local NPCEsp = (function()
	local self = {}
	local npcDrawings, npcSkelDrawings, npcTrcDrawings = {}, {}, {}
	local npcEspHeartbeat, npcSkelHeartbeat, npcTrcHeartbeat

	local bones = {
		{"Head","UpperTorso"},{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},
		{"LeftLowerArm","LeftHand"},{"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},
		{"RightLowerArm","RightHand"},{"UpperTorso","LowerTorso"},{"LowerTorso","LeftUpperLeg"},
		{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},{"LowerTorso","RightUpperLeg"},
		{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"}
	}

	local function createESP(model)
		if npcDrawings[model] then return end
		local ds = {}
		ds.box = Drawing.new("Square")
		ds.box.Visible = false; ds.box.Color = C.NPC_ESP; ds.box.Thickness = 2; ds.box.Filled = false
		ds.nameTag = Drawing.new("Text")
		ds.nameTag.Visible = false; ds.nameTag.Color = Color3.new(1,1,1); ds.nameTag.Size = 14
		ds.nameTag.Center = true; ds.nameTag.Outline = true; ds.nameTag.OutlineColor = Color3.new(0,0,0)
		ds.distTag = Drawing.new("Text")
		ds.distTag.Visible = false; ds.distTag.Color = Color3.fromRGB(100,180,255); ds.distTag.Size = 13
		ds.distTag.Center = true; ds.distTag.Outline = true; ds.distTag.OutlineColor = Color3.new(0,0,0)
		ds.healthBar = Drawing.new("Line")
		ds.healthBar.Visible = false; ds.healthBar.Thickness = 2
		npcDrawings[model] = ds
	end

	local function createSkel(model)
		if npcSkelDrawings[model] then return end
		local lines = {}
		for _ = 1, 14 do
			local line = Drawing.new("Line")
			line.Visible = false; line.Color = C.NPC_SKELETON; line.Thickness = 1.5
			table.insert(lines, line)
		end
		npcSkelDrawings[model] = {lines = lines}
	end

	local function createTrc(model)
		if npcTrcDrawings[model] then return end
		local line = Drawing.new("Line")
		line.Visible = false; line.Color = C.NPC_TRACER; line.Thickness = 1.5
		npcTrcDrawings[model] = line
	end

	function self.scan()
		for _, obj in ipairs(H.activeNPCs) do
			if H.isNPC(obj) then
				if S.npcEspBox      then createESP(obj) end
				if S.npcEspSkeleton then createSkel(obj) end
				if S.npcEspTracer   then createTrc(obj) end
			end
		end
	end

	local function updateESP()
		for model, ds in pairs(npcDrawings) do
			if model and model.Parent and H.isNPC(model) then
				local head = model:FindFirstChild("Head")
				local root = model:FindFirstChild("HumanoidRootPart")
				local hum  = model:FindFirstChild("Humanoid")
				if head and root and hum then
					local top = head.Position + Vector3.new(0, 1.2, 0)
					local bottom = root.Position - Vector3.new(0, 2.8, 0)
					local topV, topOn = Camera:WorldToViewportPoint(top)
					local botV, botOn = Camera:WorldToViewportPoint(bottom)
					if topOn and botOn and topV.Z > 0 and botV.Z > 0 then
						local h = math.abs(botV.Y - topV.Y)
						local w = h * 0.5
						local pos = Vector2.new(topV.X - w/2, topV.Y)
						ds.box.Size = Vector2.new(w, h); ds.box.Position = pos; ds.box.Visible = true
						ds.box.Color = C.NPC_ESP
						local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
						local dist = myRoot and math.floor((myRoot.Position - root.Position).Magnitude * 0.28) or 0
						ds.nameTag.Position = Vector2.new(topV.X, pos.Y - 16)
						ds.nameTag.Visible = true
						ds.nameTag.Text = model.Name .. " [" .. math.floor(hum.Health) .. "HP]"
						ds.distTag.Position = Vector2.new(topV.X, pos.Y - 30)
						ds.distTag.Visible = true
						ds.distTag.Text = dist .. "m"
						local hp = hum.Health / hum.MaxHealth
						local barHeight = h * hp
						local barX = pos.X + w + 3
						local barTopY = pos.Y + h - barHeight
						ds.healthBar.From = Vector2.new(barX, barTopY)
						ds.healthBar.To = Vector2.new(barX, pos.Y + h)
						ds.healthBar.Color = hp > 0.5 and Color3.fromRGB(0,255,0) or hp > 0.25 and Color3.fromRGB(255,255,0) or Color3.fromRGB(255,0,0)
						ds.healthBar.Visible = true
					else
						ds.box.Visible = false; ds.nameTag.Visible = false
						ds.distTag.Visible = false; ds.healthBar.Visible = false
					end
				else
					ds.box.Visible = false; ds.nameTag.Visible = false
					ds.distTag.Visible = false; ds.healthBar.Visible = false
				end
			else
				ds.box:Remove(); ds.nameTag:Remove(); ds.distTag:Remove(); ds.healthBar:Remove()
				npcDrawings[model] = nil
			end
		end
	end

	local function updateSkel()
		for model, data in pairs(npcSkelDrawings) do
			if model and model.Parent and H.isNPC(model) then
				local parts = {}
				local ok = true
				for _, pair in ipairs(bones) do
					local p1 = model:FindFirstChild(pair[1])
					local p2 = model:FindFirstChild(pair[2])
					if p1 and p2 then parts[pair[1]] = p1; parts[pair[2]] = p2
					else ok = false; break end
				end
				if ok then
					for i, pair in ipairs(bones) do
						local pos1 = Camera:WorldToViewportPoint(parts[pair[1]].Position)
						local pos2 = Camera:WorldToViewportPoint(parts[pair[2]].Position)
						local line = data.lines[i]
						if pos1.Z > 0 and pos2.Z > 0 then
							line.From = Vector2.new(pos1.X, pos1.Y)
							line.To = Vector2.new(pos2.X, pos2.Y)
							line.Visible = true
							line.Color = C.NPC_SKELETON
						else line.Visible = false end
					end
				else
					for _, l in ipairs(data.lines) do l.Visible = false end
				end
			else
				for _, l in ipairs(data.lines) do l:Remove() end
				npcSkelDrawings[model] = nil
			end
		end
	end

	local function updateTrc()
		for model, line in pairs(npcTrcDrawings) do
			if model and model.Parent and H.isNPC(model) then
				local root = model:FindFirstChild("HumanoidRootPart")
				if root then
					local sw, sh = Camera.ViewportSize.X, Camera.ViewportSize.Y
					local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
					if onScreen and pos.Z > 0 then
						line.From = Vector2.new(sw/2, sh)
						line.To = Vector2.new(pos.X, pos.Y)
						line.Visible = true
						line.Color = C.NPC_TRACER
					else line.Visible = false end
				else line.Visible = false end
			else
				line:Remove()
				npcTrcDrawings[model] = nil
			end
		end
	end

	function self.startESP()
		if npcEspHeartbeat then npcEspHeartbeat:Disconnect() end
		self.scan()
		npcEspHeartbeat = RunService.Heartbeat:Connect(updateESP)
	end
	function self.stopESP()
		if npcEspHeartbeat then npcEspHeartbeat:Disconnect(); npcEspHeartbeat = nil end
		for _, ds in pairs(npcDrawings) do
			ds.box:Remove(); ds.nameTag:Remove(); ds.distTag:Remove(); ds.healthBar:Remove()
		end
		npcDrawings = {}
	end
	function self.startSkeleton()
		if npcSkelHeartbeat then npcSkelHeartbeat:Disconnect() end
		self.scan()
		npcSkelHeartbeat = RunService.Heartbeat:Connect(updateSkel)
	end
	function self.stopSkeleton()
		if npcSkelHeartbeat then npcSkelHeartbeat:Disconnect(); npcSkelHeartbeat = nil end
		for _, data in pairs(npcSkelDrawings) do
			for _, l in ipairs(data.lines) do l:Remove() end
		end
		npcSkelDrawings = {}
	end
	function self.startTracer()
		if npcTrcHeartbeat then npcTrcHeartbeat:Disconnect() end
		self.scan()
		npcTrcHeartbeat = RunService.Heartbeat:Connect(updateTrc)
	end
	function self.stopTracer()
		if npcTrcHeartbeat then npcTrcHeartbeat:Disconnect(); npcTrcHeartbeat = nil end
		for _, l in pairs(npcTrcDrawings) do l:Remove() end
		npcTrcDrawings = {}
	end

	function self.setBox(on) S.npcEspBox = on; if on then self.startESP() else self.stopESP() end end
	function self.setSkeleton(on) S.npcEspSkeleton = on; if on then self.startSkeleton() else self.stopSkeleton() end end
	function self.setTracer(on) S.npcEspTracer = on; if on then self.startTracer() else self.stopTracer() end end

	function self.createESP(model) createESP(model) end
	function self.createSkeleton(model) createSkel(model) end
	function self.createTracer(model) createTrc(model) end

	local npcScanQueued = false
	Workspace.DescendantAdded:Connect(function(desc)
		-- Descendant replication is noisy. Only rebuild NPC drawings when an NPC
		-- ESP mode is actually enabled.
		if (S.npcEspBox or S.npcEspSkeleton or S.npcEspTracer) and not npcScanQueued then
			npcScanQueued = true
			task.defer(function()
				npcScanQueued = false
				self.scan()
			end)
		end
	end)

	return self
end)()

-- GLOW
local Glow = (function()
	local self = {}
	local activeHighlights = {}

	local function applyGlowToModel(model)
		if not model or not model.Parent then return end
		if activeHighlights[model] then activeHighlights[model]:Destroy() end
		local hl = Instance.new("Highlight")
		hl.FillTransparency    = 1
		hl.OutlineColor        = C.GLOW
		hl.OutlineTransparency = S.glowTransparency
		hl.Parent              = model
		activeHighlights[model] = hl
	end

	local function removeGlowFromModel(model)
		if activeHighlights[model] then
			activeHighlights[model]:Destroy()
			activeHighlights[model] = nil
		end
	end

	function self.update()
		for _, hl in pairs(activeHighlights) do
			hl.OutlineTransparency = S.glowTransparency
		end
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				local char = plr.Character
				if S.playerGlow then
					if char and not activeHighlights[char] then applyGlowToModel(char) end
				elseif char then
					removeGlowFromModel(char)
				end
			end
		end
		for _, npc in ipairs(H.activeNPCs) do
			if npc and npc.Parent then
				if S.npcGlow then
					if not activeHighlights[npc] then applyGlowToModel(npc) end
				else
					removeGlowFromModel(npc)
				end
			end
		end
	end

	function self.applyToModel(model) applyGlowToModel(model) end
	function self.removeFromModel(model) removeGlowFromModel(model) end

	function self.setPlayerGlow(on) S.playerGlow = on; self.update() end
	function self.setNpcGlow(on)    S.npcGlow = on;    self.update() end
	function self.setTransparency(v)
		S.glowTransparency = v
		for _, hl in pairs(activeHighlights) do hl.OutlineTransparency = v end
	end
	function self.setColor(c)
		for _, hl in pairs(activeHighlights) do hl.OutlineColor = c end
	end

	return self
end)()

-- FOOTSTEPS
local Footsteps = (function()
	local self = {}
	local activeFootsteps = {}
	local timer = 0
	local interval = 0.5
	local duration = 2

	local function clearAll()
		for _, fs in ipairs(activeFootsteps) do fs.drawing:Remove() end
		activeFootsteps = {}
	end

	local function addFootstep(position)
		local circle = Drawing.new("Circle")
		circle.Position     = Camera:WorldToViewportPoint(position)
		circle.Radius       = S.footstepSize
		circle.Color        = C.FOOTSTEP
		circle.Thickness    = 1
		circle.Filled       = true
		circle.Transparency = 0.8
		circle.Visible      = true
		table.insert(activeFootsteps, {drawing = circle, expiry = os.clock() + duration, worldPos = position})
	end

	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		for i = #activeFootsteps, 1, -1 do
			local fs = activeFootsteps[i]
			if now >= fs.expiry then
				fs.drawing:Remove()
				table.remove(activeFootsteps, i)
			else
				local sp = Camera:WorldToViewportPoint(fs.worldPos)
				fs.drawing.Position = Vector2.new(sp.X, sp.Y)
				fs.drawing.Visible  = sp.Z > 0
			end
		end
		if not S.footsteps then return end
		timer = timer + dt
		if timer >= interval then
			timer = 0
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= LocalPlayer then
					local char = plr.Character
					local root = char and char:FindFirstChild("HumanoidRootPart")
					if root then addFootstep(root.Position) end
				end
			end
			for _, npc in ipairs(H.activeNPCs) do
				if npc and npc.Parent then
					local root = npc:FindFirstChild("HumanoidRootPart")
					if root then addFootstep(root.Position) end
				end
			end
		end
	end)

	function self.setEnabled(on) S.footsteps = on; if not on then clearAll() end end
	function self.setSize(v) S.footstepSize = v end
	function self.setColor(c) C.FOOTSTEP = c end

	return self
end)()

-- PLAYER LIST
local AdminTools = (function()
	local self = {}
	local spectating = nil
	local freeCamConnection = nil

	local function updateFreeCam()
		local char = spectating and spectating.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChild("Humanoid")
		if not root or not hum or hum.Health <= 0 then
			self.stopSpectating()
			return
		end
		local target = root.Position + Vector3.new(0, 2, 0)
		local cameraPosition = target - root.CFrame.LookVector * 10 + Vector3.new(0, 4, 0)
		Camera.CameraType = Enum.CameraType.Scriptable
		Camera.CFrame = CFrame.lookAt(cameraPosition, target)
	end

	function self.spectate(plr)
		local hum = plr and plr.Character and plr.Character:FindFirstChild("Humanoid")
		if not hum then return end
		spectating = plr
		if not freeCamConnection then
			freeCamConnection = RunService.RenderStepped:Connect(updateFreeCam)
		end
		updateFreeCam()
	end

	function self.stopSpectating()
		spectating = nil
		if freeCamConnection then freeCamConnection:Disconnect(); freeCamConnection = nil end
		Camera.CameraType = Enum.CameraType.Custom
		local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
		if hum then Camera.CameraSubject = hum end
	end

	Players.PlayerRemoving:Connect(function(plr)
		if plr == spectating then self.stopSpectating() end
	end)
	LocalPlayer.CharacterAdded:Connect(function() task.defer(self.stopSpectating) end)

	return self
end)()

-- FREE FLY CAMERA
local Freecam = (function()
	local self = {}
	local connection, savedCameraType, savedMouseBehavior, savedMouseIcon
	local position, yaw, pitch = nil, 0, 0
	local overlayCallback

	local function stop()
		if connection then connection:Disconnect(); connection = nil end
		if savedCameraType then Camera.CameraType = savedCameraType end
		if savedMouseBehavior then UserInputService.MouseBehavior = savedMouseBehavior end
		if savedMouseIcon ~= nil then UserInputService.MouseIconEnabled = savedMouseIcon end
		savedCameraType, savedMouseBehavior, savedMouseIcon = nil, nil, nil
		S.freeCam = false
		if overlayCallback then overlayCallback(false) end
	end

	local function update(dt)
		-- Scriptable cameras can be reset by other UI interactions; keep mouse look
		-- captured every frame while freecam is active.
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		local delta = UserInputService:GetMouseDelta()
		yaw = yaw - delta.X * 0.0025
		pitch = math.clamp(pitch - delta.Y * 0.0025, -1.45, 1.45)
		local rotation = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
		local move = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + rotation.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - rotation.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + rotation.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - rotation.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.E) then move = move + Vector3.yAxis end
		if UserInputService:IsKeyDown(Enum.KeyCode.Q) then move = move - Vector3.yAxis end
		local speed = S.freeCamSpeed
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then speed = speed * 3 end
		if move.Magnitude > 0 then position = position + move.Unit * speed * dt end
		Camera.CFrame = CFrame.new(position) * rotation
	end

	function self.setEnabled(on)
		if not on then stop(); return end
		if connection then return end
		AdminTools.stopSpectating()
		savedCameraType = Camera.CameraType
		savedMouseBehavior = UserInputService.MouseBehavior
		savedMouseIcon = UserInputService.MouseIconEnabled
		position = Camera.CFrame.Position
		local look = Camera.CFrame.LookVector
		yaw = math.atan2(-look.X, -look.Z)
		pitch = math.asin(look.Y)
		Camera.CameraType = Enum.CameraType.Scriptable
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = false
		S.freeCam = true
		connection = RunService.RenderStepped:Connect(update)
		if overlayCallback then overlayCallback(true) end
	end

	function self.setSpeed(speed) S.freeCamSpeed = speed end
	function self.startNearPlayer(plr)
		local root = plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		if not root then return false end
		if not connection then self.setEnabled(true) end
		position = root.Position - root.CFrame.LookVector * 10 + Vector3.new(0, 4, 0)
		local look = root.CFrame.LookVector
		yaw = math.atan2(-look.X, -look.Z)
		pitch = -0.18
		return true
	end
	function self.setOverlayCallback(callback) overlayCallback = callback end
	function self.stop() stop() end
	return self
end)()

local PlayerList = (function()
	local self = {}
	local gui = nil

	local function create()
		if gui then gui:Destroy() end
		gui = Instance.new("ScreenGui")
		gui.Name = "PlayerList"
		gui.ResetOnSpawn = false
		gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

		local frame = Instance.new("Frame", gui)
		frame.Size = UDim2.new(0, 280, 0, 300)
		frame.Position = UDim2.new(1, -290, 0.5, -150)
		frame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
		frame.BackgroundTransparency = 0.3
		frame.BorderSizePixel = 0
		frame.Active = true
		Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
		Instance.new("UIStroke", frame).Color = Color3.fromRGB(50, 50, 60)

		local hdr = Instance.new("Frame", frame)
		hdr.Size = UDim2.new(1, 0, 0, 26)
		hdr.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
		hdr.BorderSizePixel = 0
		Instance.new("UICorner", hdr).CornerRadius = UDim.new(0, 6)

		local ttl = Instance.new("TextLabel", hdr)
		ttl.Size = UDim2.new(1, -10, 1, 0)
		ttl.Position = UDim2.new(0, 5, 0, 0)
		ttl.BackgroundTransparency = 1
		ttl.Text = "Player Monitor"
		ttl.TextColor3 = Color3.fromRGB(240, 240, 240)
		ttl.Font = Enum.Font.GothamBold
		ttl.TextSize = 14
		ttl.TextXAlignment = Enum.TextXAlignment.Left

		local scroll = Instance.new("ScrollingFrame", frame)
		scroll.Size = UDim2.new(1, -6, 1, -32)
		scroll.Position = UDim2.new(0, 3, 0, 28)
		scroll.BackgroundTransparency = 1
		scroll.ScrollBarThickness = 3
		scroll.ScrollBarImageColor3 = Color3.fromRGB(100, 140, 255)
		scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
		scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
		local ll = Instance.new("UIListLayout", scroll)
		ll.Padding = UDim.new(0, 2)

		local drag, ds, sp = false, nil, nil
		hdr.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				drag = true; ds = input.Position; sp = frame.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then drag = false end
				end)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if drag and input.UserInputType == Enum.UserInputType.MouseMovement then
				local d = input.Position - ds
				frame.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
			end
		end)

		local function update()
			if not S.playerList then return end
			for _, ch in ipairs(scroll:GetChildren()) do
				if ch:IsA("Frame") then ch:Destroy() end
			end
			local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			local data = {}
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= LocalPlayer then
					local char = plr.Character
					if char then
						local root = char:FindFirstChild("HumanoidRootPart")
						local hum  = char:FindFirstChild("Humanoid")
						if root and hum and hum.Health > 0 then
							local dist = myRoot and (myRoot.Position - root.Position).Magnitude * 0.28 or 9999
							local value = Inventory.getTotalValue(plr)
							table.insert(data, {plr = plr, dist = dist, hp = hum.Health, maxhp = hum.MaxHealth, value = value})
						end
					end
				end
			end
			table.sort(data, function(a, b) return a.dist < b.dist end)
			for _, d in ipairs(data) do
				local row = Instance.new("Frame", scroll)
				row.Size = UDim2.new(1, -6, 0, 42)
				row.BackgroundColor3 = (d.hp < d.maxhp * 0.25) and Color3.fromRGB(80,20,20) or Color3.fromRGB(35,35,45)
				row.BackgroundTransparency = 0.3
				row.BorderSizePixel = 0
				Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)

				local lbl = Instance.new("TextLabel", row)
				lbl.Size = UDim2.new(1, -100, 0, 20)
				lbl.Position = UDim2.new(0, 8, 0, 1)
				lbl.BackgroundTransparency = 1
				lbl.Text = string.format("%s [%.0f HP] [%.0f m]", d.plr.Name, d.hp, d.dist)
				lbl.TextColor3 = Color3.fromRGB(240, 240, 240)
				lbl.Font = Enum.Font.Gotham
				lbl.TextSize = 13
				lbl.TextXAlignment = Enum.TextXAlignment.Left

				local valueLbl = Instance.new("TextLabel", row)
				valueLbl.Size = UDim2.new(1, -100, 0, 16); valueLbl.Position = UDim2.new(0, 8, 0, 21)
				valueLbl.BackgroundTransparency = 1; valueLbl.Text = string.format("Inventory: $%d", math.floor(d.value))
				valueLbl.TextColor3 = Color3.fromRGB(60, 200, 120); valueLbl.Font = Enum.Font.Gotham; valueLbl.TextSize = 11
				valueLbl.TextXAlignment = Enum.TextXAlignment.Left

				local spectateBtn = Instance.new("TextButton", row)
				spectateBtn.Size = UDim2.new(0, 38, 0, 24); spectateBtn.Position = UDim2.new(1, -44, 0.5, -12)
				spectateBtn.BackgroundColor3 = Color3.fromRGB(100, 140, 255); spectateBtn.Text = "View"
				spectateBtn.TextColor3 = Color3.new(1, 1, 1); spectateBtn.Font = Enum.Font.GothamBold; spectateBtn.TextSize = 10; spectateBtn.BorderSizePixel = 0
				Instance.new("UICorner", spectateBtn).CornerRadius = UDim.new(0, 4)
				spectateBtn.MouseButton1Click:Connect(function() AdminTools.spectate(d.plr) end)

			end
		end

		local last = 0
		RunService.Heartbeat:Connect(function(dt)
			if not S.playerList then return end
			last = last + dt
			if last >= 0.5 then last = 0; update() end
		end)
		update()
	end

	function self.setEnabled(on)
		S.playerList = on
		if on then create()
		elseif gui then gui:Destroy(); gui = nil end
	end

	return self
end)()

-- WORLD
local World = (function()
	local self = {}
	local originalLight = {}
	local originalFogStart, originalFogEnd = nil, nil

	local function saveLight()
		originalLight = {
			GlobalShadows = Lighting.GlobalShadows, Brightness = Lighting.Brightness,
			Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
			FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart,
			FogColor = Lighting.FogColor, ClockTime = Lighting.ClockTime,
			TimeOfDay = Lighting.TimeOfDay,
		}
	end

	local function applyFB()
		Lighting.GlobalShadows = false; Lighting.Brightness = 2
		Lighting.Ambient = Color3.fromRGB(178,178,178)
		Lighting.OutdoorAmbient = Color3.fromRGB(178,178,178)
		Lighting.FogEnd = 100000; Lighting.FogStart = 0
		Lighting.FogColor = Color3.fromRGB(255,255,255); Lighting.ClockTime = 14
	end

	local function restoreLight()
		for prop, value in pairs(originalLight) do
			if Lighting[prop] ~= nil then Lighting[prop] = value end
		end
	end

	function self.setFullbright(on)
		S.fullbright = on
		if on then saveLight(); applyFB() else restoreLight() end
	end

	function self.setNoFog(on)
		S.noFog = on
		if on then
			originalFogStart = Lighting.FogStart
			originalFogEnd   = Lighting.FogEnd
			Lighting.FogStart = 0; Lighting.FogEnd = 100000
		elseif originalFogStart ~= nil then
			Lighting.FogStart = originalFogStart
			Lighting.FogEnd   = originalFogEnd
		end
	end

	return self
end)()

-- CAMERA FOV
local CamFOV = (function()
	local self = {}
	RunService:BindToRenderStep("FOVLock", Enum.RenderPriority.Last.Value, function()
		Camera.FieldOfView = UserInputService:IsKeyDown(S.zoomKey) and S.zoomFov or S.baseFov
	end)
	function self.setBase(v) S.baseFov = v end
	function self.setZoom(v) S.zoomFov = v end
	return self
end)()

-- DYNAMIC WEAPON PROFILE: reads the effective values currently shown by the
-- game's inspection card, so attachments are reflected automatically.
local WeaponAssist = (function()
	local self = {}
	local profile = {velocity=1000, vertical=0, horizontal=0, name="Unknown"}
	local lastRead, boundSound = 0, nil
	local function numberFrom(text)
		return tonumber(tostring(text or ""):match("[-+]?%d+%.?%d*"))
	end
	local function readField(root, fieldName)
		local label = root:FindFirstChild(fieldName, true)
		if not label then return nil end
		for _, node in ipairs(label.Parent:GetDescendants()) do
			if node ~= label and (node:IsA("TextLabel") or node:IsA("TextButton")) then
				local value = numberFrom(node.Text)
				if value then return value end
			end
		end
		return nil
	end
	local function refresh()
		local gui = LocalPlayer:FindFirstChild("PlayerGui")
		local box = gui and gui:FindFirstChild("InspectionBox", true)
		if box then
			local title = box:FindFirstChild("ItemName", true)
			profile.name = title and title.Text or profile.name
			profile.velocity = readField(box, "MuzzleVelocity") or profile.velocity
			profile.vertical = readField(box, "VerticalRecoil") or profile.vertical
			profile.horizontal = readField(box, "HorizontalRecoil") or profile.horizontal
		end
	end
	local function compensate()
		if not S.weaponAntiRecoil then return end
		local v = math.rad(profile.vertical * 0.0022 * S.weaponRecoilStrength)
		local h = math.rad(profile.horizontal * 0.0007 * S.weaponRecoilStrength)
		Camera.CFrame = Camera.CFrame * CFrame.Angles(-v, (math.random() < 0.5 and h or -h), 0)
	end
	RunService.Heartbeat:Connect(function()
		-- Do not inspect the whole weapon UI/model every frame while the feature
		-- is unused. Ballistic data is only needed by prediction/recoil.
		if not (S.weaponPrediction or S.weaponAntiRecoil) then return end
		if os.clock() - lastRead > 0.5 then lastRead = os.clock(); refresh() end
		local vm = H.getViewModel()
		local sound = vm and (vm:FindFirstChild("FireSound", true) or vm:FindFirstChild("FireFarSound", true))
		if sound and sound ~= boundSound and sound:IsA("Sound") then
			boundSound = sound
			sound.Played:Connect(compensate)
		end
	end)
	function self.getVelocity() return profile.velocity end
	function self.getProfile() return profile end
	return self
end)()
-- ============================================================
-- AIMBOT
-- ============================================================
local Aimbot = (function()
	local self = {}
	local heartbeat = nil

	local fovCircle = Drawing.new("Circle")
	fovCircle.Visible = false
	fovCircle.Color = C.AIM_FOV
	fovCircle.Thickness = 1.5
	fovCircle.Filled = false
	fovCircle.Transparency = 0.7

	local function updateFovCircle()
		if not fovCircle.Visible then return end
		local ss = Camera.ViewportSize
		local center = Vector2.new(ss.X / 2, ss.Y / 2)
		local vf = math.rad(Camera.FieldOfView)
		local sd = (ss.Y / 2) / math.tan(vf / 2)
		local radius = sd * math.tan(math.rad(S.aimFov) / 2)
		fovCircle.Position = center
		fovCircle.Radius = radius
	end
	self.updateFovCircle = updateFovCircle

	Camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateFovCircle)
	Camera:GetPropertyChangedSignal("FieldOfView"):Connect(updateFovCircle)

	local function getClosestTarget(applyPrediction)
		local camPos = Camera.CFrame.Position
		local camDir = Camera.CFrame.LookVector
		local best, bestScore = nil, math.huge

		local function considerCharacter(char)
			local target = char:FindFirstChild(S.aimPart) or char:FindFirstChild("Head")
			local hum = char:FindFirstChild("Humanoid")
			if not (target and hum and hum.Health > 0) then return end
			local root = char:FindFirstChild("HumanoidRootPart")
			local checkPos = root and root.Position or target.Position
			if S.aimVisibleOnly and not H.isVisible(checkPos, char) then return end
			local p = target.Position
			if applyPrediction and S.aimPrediction > 0 and root then
				local velocity = S.weaponPrediction and WeaponAssist.getVelocity() or 1000
				local travelTime = (p - camPos).Magnitude / math.max(velocity, 1)
				p = p + root.Velocity * travelTime * S.aimPrediction
				if S.weaponPrediction then p = p + Vector3.new(0, 0.5 * Workspace.Gravity * travelTime * travelTime * S.weaponDropScale, 0) end
			end
			local dir = (p - camPos).Unit
			local angle = math.deg(math.acos(math.clamp(camDir:Dot(dir), -1, 1)))
			if angle < (S.aimFov / 2) and angle < bestScore then
				bestScore = angle
				best = {pos = p, model = char, root = root}
			end
		end

		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then considerCharacter(plr.Character) end
		end
		if S.aimNPCs then
			for _, npc in ipairs(H.activeNPCs) do
				if npc.Parent and H.isNPC(npc) then considerCharacter(npc) end
			end
		end
		return best
	end

	local function lockUpdate()
		if not isHolding then return end
		local t = getClosestTarget(true)
		if t then
			Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, t.pos), S.aimSmoothing)
		end
	end

	local function silentUpdate()
		if not isHolding then return end
		local t = getClosestTarget(false)
		if not t then return end
		if S.silentHitChance < math.random() * 100 then return end

		local vm = H.getViewModel()
		if not vm then return end

		local camPos = Camera.CFrame.Position
		local targetPos = t.pos
		if S.perfectSilent then
			targetPos = targetPos - Vector3.new(0, 0.15, 0)
		else
			targetPos = targetPos - Vector3.new(0, 1.75, 0)
		end

		local muzzleVel = S.weaponPrediction and WeaponAssist.getVelocity() or 1000
		if S.aimPrediction > 0 and t.root then
			local distance = (targetPos - camPos).Magnitude
			local aimTime = distance / muzzleVel
			local vel = t.root.Velocity
			targetPos = Vector3.new(
				targetPos.X + vel.X * aimTime * S.aimPrediction,
				targetPos.Y,
				targetPos.Z + vel.Z * aimTime * S.aimPrediction
			)
		end

		local partToRotate = nil
		if S.perfectSilent then
			local item = vm:FindFirstChild("Item")
			if item then
				local ap = item:FindFirstChild("AttachmentPoints")
				if ap then
					local extra = ap:FindFirstChild("Extra")
					if extra and extra:IsA("Attachment") then
						partToRotate = extra
					end
				end
			end
		end
		if not partToRotate then
			partToRotate = vm:FindFirstChild("HumanoidRootPart")
		end
		if not partToRotate then return end

		if partToRotate:IsA("Attachment") then
			partToRotate.WorldCFrame = CFrame.lookAt(partToRotate.WorldPosition, targetPos)
		else
			partToRotate.CFrame = CFrame.new(partToRotate.Position, targetPos)
		end
	end

	RunService.RenderStepped:Connect(function()
		if fovCircle.Visible then updateFovCircle() end
	end)

	function self.start()
		if heartbeat then heartbeat:Disconnect() end
		fovCircle.Visible = true
		updateFovCircle()
		if S.aimMode == "Silent" then
			heartbeat = RunService.RenderStepped:Connect(silentUpdate)
		else
			heartbeat = RunService.Heartbeat:Connect(lockUpdate)
		end
	end

	function self.stop()
		if heartbeat then heartbeat:Disconnect(); heartbeat = nil end
		fovCircle.Visible = false
	end
	function self.destroy()
		self.stop()
		fovCircle:Remove()
	end

	function self.setEnabled(on)
		S.aimEnabled = on
		if on then self.start() else isHolding = false; self.stop() end
	end

	function self.setMode(mode)
		S.aimMode = mode
		if S.aimEnabled then self.stop(); self.start() end
	end

	function self.setColor(c) fovCircle.Color = c end

	return self
end)()

-- ============================================================
-- VIEWMODEL (hands + weapon)
-- ============================================================
local VM = (function()
	local self = {}
	local savedJoints, savedParts, savedTex, savedSurf, savedCloth, savedAcc = {}, {}, {}, {}, {}, {}
	local lastVM = nil
	local wpnSavedParts, wpnSavedTex, wpnSavedSurf = {}, {}, {}
	local lastWpnRoot = nil

	local function getWeaponRoot(vm)
		if not vm then return nil end
		for _, name in ipairs({"Item", "Weapon", "Gun"}) do
			local f = vm:FindFirstChild(name)
			if f then return f end
		end
		local char = LocalPlayer.Character
		if char then
			local tool = char:FindFirstChildOfClass("Tool")
			if tool then
				local f = vm:FindFirstChild(tool.Name)
				if f then return f end
			end
		end
		for _, c in ipairs(vm:GetChildren()) do
			if c:IsA("Model") then return c end
		end
		return nil
	end
	self.getWeaponRoot = getWeaponRoot

	local function collectRootJoints(vm)
		local all = {}
		for _, d in ipairs(vm:GetDescendants()) do
			if d:IsA("Motor6D") then table.insert(all, d) end
		end
		local childParts = {}
		for _, j in ipairs(all) do
			if j.Part1 then childParts[j.Part1] = true end
		end
		local roots = {}
		for _, j in ipairs(all) do
			if j.Part0 and not childParts[j.Part0] then table.insert(roots, j) end
		end
		return roots
	end

	local function stripOverlays(vm)
		for _, desc in ipairs(vm:GetDescendants()) do
			if desc:IsA("SurfaceAppearance") then
				if savedSurf[desc] == nil then savedSurf[desc] = desc.Parent end
				desc.Parent = nil
			elseif desc:IsA("Texture") or desc:IsA("Decal") then
				if savedTex[desc] == nil then savedTex[desc] = desc.Transparency end
				desc.Transparency = 1
			elseif desc:IsA("Shirt") then
				if savedCloth[desc] == nil then savedCloth[desc] = {p="ShirtTemplate", v=desc.ShirtTemplate} end
				desc.ShirtTemplate = ""
			elseif desc:IsA("Pants") then
				if savedCloth[desc] == nil then savedCloth[desc] = {p="PantsTemplate", v=desc.PantsTemplate} end
				desc.PantsTemplate = ""
			elseif desc:IsA("Accessory") then
				local h = desc:FindFirstChild("Handle")
				if h and h:IsA("BasePart") then
					if savedAcc[h] == nil then savedAcc[h] = h.Transparency end
					h.Transparency = 1
				end
			end
		end
	end

	local function applyVM()
		local vm = H.getViewModel()
		if not vm then return end
		if lastVM ~= vm then
			savedJoints, savedParts, savedTex = {}, {}, {}
			savedSurf, savedCloth, savedAcc = {}, {}, {}
			lastVM = vm
		end
		local offset = Vector3.new(S.vmOffsetX, S.vmOffsetY, S.vmOffsetZ)
		for _, j in ipairs(collectRootJoints(vm)) do
			if not savedJoints[j] then savedJoints[j] = j.C0 end
			j.C0 = savedJoints[j] + offset
		end
		local wr = getWeaponRoot(vm)
		for _, d in ipairs(vm:GetDescendants()) do
			if d:IsA("BasePart") and not H.isDescendantOf(d, wr) then
				if not savedParts[d] then savedParts[d] = {c=d.Color, t=d.Transparency} end
				d.Color = S.vmColor
				d.Transparency = S.vmTransparency
			end
		end
		stripOverlays(vm)
	end

	local function resetVM()
		for j, c0 in pairs(savedJoints) do if j and j.Parent then j.C0 = c0 end end
		for p, data in pairs(savedParts) do
			if p and p.Parent then p.Color = data.c; p.Transparency = data.t end
		end
		for t, tr in pairs(savedTex) do if t and t.Parent then t.Transparency = tr end end
		for s, parent in pairs(savedSurf) do if s then s.Parent = parent end end
		for c, data in pairs(savedCloth) do if c and c.Parent then c[data.p] = data.v end end
		for h, tr in pairs(savedAcc) do if h and h.Parent then h.Transparency = tr end end
		savedJoints, savedParts, savedTex = {}, {}, {}
		savedSurf, savedCloth, savedAcc = {}, {}, {}
		lastVM = nil
	end

	local function applyWpn()
		local vm = H.getViewModel()
		if not vm then return end
		local wr = getWeaponRoot(vm)
		if not wr then return end
		if lastWpnRoot ~= wr then
			wpnSavedParts, wpnSavedTex, wpnSavedSurf = {}, {}, {}
			lastWpnRoot = wr
		end
		for _, d in ipairs(wr:GetDescendants()) do
			if d:IsA("BasePart") then
				if not wpnSavedParts[d] then wpnSavedParts[d] = {c=d.Color, t=d.Transparency} end
				d.Color = S.wpnColor
				d.Transparency = S.wpnTransparency
			end
		end
		for _, desc in ipairs(wr:GetDescendants()) do
			if desc:IsA("SurfaceAppearance") then
				if wpnSavedSurf[desc] == nil then wpnSavedSurf[desc] = desc.Parent end
				desc.Parent = nil
			elseif desc:IsA("Texture") or desc:IsA("Decal") then
				if wpnSavedTex[desc] == nil then wpnSavedTex[desc] = desc.Transparency end
				desc.Transparency = 1
			end
		end
	end

	local function resetWpn()
		for p, data in pairs(wpnSavedParts) do
			if p and p.Parent then p.Color = data.c; p.Transparency = data.t end
		end
		for t, tr in pairs(wpnSavedTex) do if t and t.Parent then t.Transparency = tr end end
		for s, parent in pairs(wpnSavedSurf) do if s then s.Parent = parent end end
		wpnSavedParts, wpnSavedTex, wpnSavedSurf = {}, {}, {}
		lastWpnRoot = nil
	end

	RunService:BindToRenderStep("CheatViewModel", Enum.RenderPriority.Camera.Value + 1, function()
		if S.vmEnabled then applyVM()
		elseif next(savedParts) or next(savedJoints) or next(savedSurf) then resetVM() end

		if S.wpnEnabled then applyWpn()
		elseif next(wpnSavedParts) or next(wpnSavedTex) or next(wpnSavedSurf) then resetWpn() end
	end)

	function self.setVMEnabled(on) S.vmEnabled = on; if not on then resetVM() end end
	function self.setVMTransparency(v) S.vmTransparency = v end
	function self.setVMOffset(x, y, z)
		if x ~= nil then S.vmOffsetX = x end
		if y ~= nil then S.vmOffsetY = y end
		if z ~= nil then S.vmOffsetZ = z end
	end
	function self.setVMColor(c) S.vmColor = c end
	function self.setWpnEnabled(on) S.wpnEnabled = on; if not on then resetWpn() end end
	function self.setWpnTransparency(v) S.wpnTransparency = v end
	function self.setWpnColor(c) S.wpnColor = c end

	return self
end)()

-- ============================================================
-- INVENTORY
-- ============================================================
Inventory = (function()
	local self = {}
	local pinnedPlayer = nil
	local CFG = {
		playersFolderName  = "Players",
		itemsListName      = "ItemsList",
		itemPropsName      = "ItemProperties",
		itemIconName       = "ItemIcon",
		amountAttr         = "Amount",
		priceAttr          = "Price",
		slotAttr           = "Slot",
		inventoryChildName = "Inventory",
		attachmentsName    = "Attachments",
		droppedItemsFolder = "DroppedItems",
	}

	local MAIN_SLOT_COUNT = 12
	local FULL_SLOT_COUNT = 54

	local function getPlayersFolder() return ReplicatedStorage:FindFirstChild(CFG.playersFolderName) end
	local function getItemsList()     return ReplicatedStorage:FindFirstChild(CFG.itemsListName) end

	local function getInventoryOf(target)
		local char
		if typeof(target) == "Instance" and target:IsA("Player") then
			char = target.Character
		else
			char = target
		end
		if not char then return nil end
		local inv = char:FindFirstChild(CFG.inventoryChildName)
		if inv then return inv end
		if typeof(target) == "Instance" and target:IsA("Player") then
			local pf = getPlayersFolder()
			if pf then
				local pd = pf:FindFirstChild(target.Name)
				if pd then
					local inv2 = pd:FindFirstChild(CFG.inventoryChildName)
					if inv2 then return inv2 end
				end
			end
		end
		return nil
	end

	local function getItemDef(item)
		local items = getItemsList()
		if not items then return nil end
		return items:FindFirstChild(item.Name)
	end

	local function getItemIcon(item)
		local def = getItemDef(item)
		if not def then return nil end
		local props = def:FindFirstChild(CFG.itemPropsName)
		if not props then return nil end
		local icon = props:FindFirstChild(CFG.itemIconName)
		if not icon then return nil end
		if icon:IsA("ImageLabel") or icon:IsA("ImageButton") then
			return icon.Image
		elseif icon:IsA("Decal") or icon:IsA("Texture") then
			return icon.Texture
		end
		return nil
	end

	local function getItemValue(item)
		-- Container slots can carry their own live price. Prefer it before
		-- consulting the replicated definition database.
		local directPrice = item:GetAttribute(CFG.priceAttr) or item:GetAttribute("Value")
		local amount = item:GetAttribute(CFG.amountAttr) or 1
		if type(directPrice) == "number" and directPrice > 0 then
			return directPrice * (type(amount) == "number" and amount or 1)
		end
		local def = getItemDef(item)
		if not def then return 0 end
		local props = def:FindFirstChild(CFG.itemPropsName)
		if not props then return 0 end
		local price = props:GetAttribute(CFG.priceAttr) or 0
		if type(price) ~= "number" then price = 0 end
		if type(amount) ~= "number" then amount = 1 end
		return price * amount
	end

	local function parseInventory(inv)
		local result = { mainSlots = {}, attachSlots = {}, fullItems = {} }
		if not inv then return result end
		local weapons, clothing, others = {}, {}, {}
		for _, child in ipairs(inv:GetChildren()) do
			local slot = child:GetAttribute(CFG.slotAttr)
			if type(slot) == "string" then
				if slot:find("Clothing") then table.insert(clothing, child)
				elseif slot:find("Weapon") or slot:find("Primary") or slot:find("Secondary") or slot:find("Melee") then
					table.insert(weapons, child)
				else table.insert(others, child) end
			else table.insert(others, child) end
		end
		local ordered = {}
		for _, w in ipairs(weapons) do table.insert(ordered, w) end
		for _, o in ipairs(others) do table.insert(ordered, o) end
		for _, c in ipairs(clothing) do table.insert(ordered, c) end
		for i = 1, math.min(#ordered, MAIN_SLOT_COUNT) do
			result.mainSlots[i] = ordered[i]
		end
		local firstWeapon = weapons[1]
		if firstWeapon then
			local att = firstWeapon:FindFirstChild(CFG.attachmentsName)
			if att then
				local sorted = {}
				for _, a in ipairs(att:GetChildren()) do
					local slot = a:GetAttribute(CFG.slotAttr)
					local idx = 5
					if slot == "Magazine" then idx = 1
					elseif slot == "Sight" then idx = 2
					elseif slot == "Muzzle" then idx = 3
					elseif slot == "Extra" then idx = 4 end
					sorted[idx] = a
				end
				for i = 1, 4 do result.attachSlots[i] = sorted[i] end
			end
		end
		for _, child in ipairs(inv:GetChildren()) do
			local slot = child:GetAttribute(CFG.slotAttr)
			if slot and slot:find("Clothing") then
				local nested = child:FindFirstChild(CFG.inventoryChildName)
				if nested then
					for _, item in ipairs(nested:GetChildren()) do
						table.insert(result.fullItems, item)
					end
				end
			else table.insert(result.fullItems, child) end
		end
		return result
	end

	local function getTotalValue(target)
		local total = 0
		local inv = getInventoryOf(target)
		if not inv then return total end
		for _, item in ipairs(parseInventory(inv).fullItems) do
			total = total + getItemValue(item)
		end
		return total
	end

	local function isCorpse(model)
		if not model:IsA("Model") then return false end
		return model:FindFirstChild("Humanoid") ~= nil and model:FindFirstChild("HumanoidRootPart") ~= nil
	end

	local function findTarget()
		local camPos = Camera.CFrame.Position
		local camDir = Camera.CFrame.LookVector
		local maxAngle = math.rad(S.invMaxAngleDeg)
		local best, bestAngle = nil, maxAngle
		local function tryCandidate(pos, payload)
			local dist = (pos - camPos).Magnitude
			if dist > S.invMaxDistance then return end
			local dir = (pos - camPos).Unit
			local angle = math.acos(math.clamp(camDir:Dot(dir), -1, 1))
			if angle < bestAngle then bestAngle = angle; best = payload end
		end
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local root = player.Character:FindFirstChild("HumanoidRootPart")
				local hum  = player.Character:FindFirstChild("Humanoid")
				if root and hum and hum.Health > 0 then
					tryCandidate(root.Position, {kind="player", player=player, character=player.Character, name=player.Name})
				end
			end
		end
		if S.invIncludeCorpse then
			local folder = Workspace:FindFirstChild(CFG.droppedItemsFolder)
			if folder then
				for _, m in ipairs(folder:GetChildren()) do
					if isCorpse(m) then
						local root = m:FindFirstChild("HumanoidRootPart")
						if root then
							tryCandidate(root.Position, {kind="corpse", character=m, name=m.Name.." [Corpse]"})
						end
					end
				end
			end
		end
		return best
	end

	local hud = Instance.new("ScreenGui")
	hud.Name = "InventoryHUD"; hud.ResetOnSpawn = false; hud.IgnoreGuiInset = true
	hud.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	hud.Parent = LocalPlayer:WaitForChild("PlayerGui")

	local root = Instance.new("Frame", hud)
	root.AnchorPoint = Vector2.new(0.5, 0)
	root.Position = UDim2.new(0.5, 0, 0, 20)
	root.Size = UDim2.new(0, 640, 0, 200)
	root.BackgroundTransparency = 1
	root.Visible = false

	local invNameLbl = Instance.new("TextLabel", root)
	invNameLbl.Size = UDim2.new(1, 0, 0, 22); invNameLbl.Position = UDim2.new(0, 0, 0, 0)
	invNameLbl.BackgroundTransparency = 1; invNameLbl.TextColor3 = Color3.fromRGB(235,235,242)
	invNameLbl.Font = Enum.Font.GothamBold; invNameLbl.TextSize = 15; invNameLbl.Text = ""
	invNameLbl.TextStrokeTransparency = 0.3; invNameLbl.TextStrokeColor3 = Color3.new(0,0,0)

	local invValueLbl = Instance.new("TextLabel", root)
	invValueLbl.Size = UDim2.new(1, 0, 0, 20); invValueLbl.Position = UDim2.new(0, 0, 0, 22)
	invValueLbl.BackgroundTransparency = 1; invValueLbl.TextColor3 = Color3.fromRGB(60,200,120)
	invValueLbl.Font = Enum.Font.GothamBold; invValueLbl.TextSize = 14; invValueLbl.Text = ""
	invValueLbl.TextStrokeTransparency = 0.3; invValueLbl.TextStrokeColor3 = Color3.new(0,0,0)

	local mainRow = Instance.new("Frame", root)
	mainRow.Size = UDim2.new(1, 0, 0, 60); mainRow.Position = UDim2.new(0, 0, 0, 50)
	mainRow.BackgroundTransparency = 1
	local mainLayout = Instance.new("UIListLayout", mainRow)
	mainLayout.FillDirection = Enum.FillDirection.Horizontal
	mainLayout.Padding = UDim.new(0, 4); mainLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	local attachRow = Instance.new("Frame", root)
	attachRow.Size = UDim2.new(1, 0, 0, 26); attachRow.Position = UDim2.new(0, 0, 0, 114)
	attachRow.BackgroundTransparency = 1
	local attachLayout = Instance.new("UIListLayout", attachRow)
	attachLayout.FillDirection = Enum.FillDirection.Horizontal
	attachLayout.Padding = UDim.new(0, 4); attachLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	local fullGrid = Instance.new("Frame", root)
	fullGrid.Size = UDim2.new(1, 0, 0, 0); fullGrid.Position = UDim2.new(0, 0, 0, 146)
	fullGrid.BackgroundTransparency = 1
	local fullLayout = Instance.new("UIGridLayout", fullGrid)
	fullLayout.CellSize = UDim2.new(0, 36, 0, 36)
	fullLayout.CellPadding = UDim2.new(0, 3, 0, 3)
	fullLayout.SortOrder = Enum.SortOrder.LayoutOrder
	fullLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	local function createSlot(size, showCount)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(0, size, 0, size)
		f.BackgroundColor3 = Color3.fromRGB(20, 20, 26); f.BackgroundTransparency = 0.2
		f.BorderSizePixel = 0; f.Visible = false
		Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
		local st = Instance.new("UIStroke", f)
		st.Color = Color3.fromRGB(55, 55, 75); st.Thickness = 1
		local icon = Instance.new("ImageLabel", f)
		icon.Size = UDim2.new(1, -6, 1, -6); icon.Position = UDim2.new(0, 3, 0, 3)
		icon.BackgroundTransparency = 1; icon.ScaleType = Enum.ScaleType.Fit; icon.Image = ""
		local cnt
		if showCount then
			cnt = Instance.new("TextLabel", f)
			cnt.Size = UDim2.new(1, -4, 0, 12); cnt.Position = UDim2.new(0, 2, 1, -14)
			cnt.BackgroundTransparency = 1; cnt.TextColor3 = Color3.new(1,1,1)
			cnt.Font = Enum.Font.GothamBold; cnt.TextSize = 10
			cnt.TextXAlignment = Enum.TextXAlignment.Right
			cnt.TextStrokeTransparency = 0; cnt.TextStrokeColor3 = Color3.new(0,0,0); cnt.Text = ""
		end
		return {frame = f, icon = icon, count = cnt}
	end

	local mainSlots, attachSlots, fullSlots = {}, {}, {}
	for i = 1, MAIN_SLOT_COUNT do
		local s = createSlot(54, true); s.frame.LayoutOrder = i; s.frame.Parent = mainRow
		table.insert(mainSlots, s)
	end
	for i = 1, 4 do
		local s = createSlot(22, false); s.frame.LayoutOrder = i; s.frame.Parent = attachRow
		table.insert(attachSlots, s)
	end
	for i = 1, FULL_SLOT_COUNT do
		local s = createSlot(36, true); s.frame.LayoutOrder = i; s.frame.Parent = fullGrid
		table.insert(fullSlots, s)
	end

	local function formatAmount(n)
		n = tonumber(n) or 1
		if n >= 1000 then return math.floor(n / 100) / 10 .. "K" end
		return tostring(math.floor(n))
	end

	local function fillSlot(slot, item)
		if not item then slot.frame.Visible = false; return end
		local icon = getItemIcon(item)
		if not icon or icon == "" then slot.frame.Visible = false; return end
		slot.icon.Image = icon
		if slot.count then
			local amount = item:GetAttribute(CFG.amountAttr)
			if type(amount) == "number" and amount > 1 then
				slot.count.Text = "x" .. formatAmount(amount)
			else slot.count.Text = "" end
		end
		slot.frame.Visible = true
	end

	local function render(target)
		if not target then root.Visible = false; return end
		local inv = getInventoryOf(target.player or target.character)
		local data = parseInventory(inv)
		if S.invShowName then invNameLbl.Text = target.name; invNameLbl.Visible = true
		else invNameLbl.Visible = false end
		local mainVisible = false
		for i = 1, MAIN_SLOT_COUNT do
			fillSlot(mainSlots[i], data.mainSlots[i])
			if mainSlots[i].frame.Visible then mainVisible = true end
		end
		if S.invShowAttach and mainVisible then
			local anyAttach = false
			for i = 1, 4 do
				fillSlot(attachSlots[i], data.attachSlots[i])
				if attachSlots[i].frame.Visible then anyAttach = true end
			end
			attachRow.Visible = anyAttach
			attachRow.Size = anyAttach and UDim2.new(1, 0, 0, 26) or UDim2.new(1, 0, 0, 0)
		else attachRow.Visible = false end
		if S.invShowFull then
			local count = math.min(#data.fullItems, FULL_SLOT_COUNT)
			for i = 1, FULL_SLOT_COUNT do fillSlot(fullSlots[i], data.fullItems[i]) end
			local rows = math.ceil(count / 9)
			fullGrid.Size = UDim2.new(1, 0, 0, rows * 39)
			fullGrid.Visible = count > 0
		else
			for i = 1, FULL_SLOT_COUNT do fullSlots[i].frame.Visible = false end
			fullGrid.Visible = false
		end
		if S.invShowValue then
			local total = 0
			for _, item in ipairs(data.fullItems) do total = total + getItemValue(item) end
			invValueLbl.Text = "Value: $" .. tostring(math.floor(total))
			invValueLbl.Visible = true
		else invValueLbl.Visible = false end
		local h = 22 + 8 + 60
		if S.invShowValue then h = h + 20 end
		if attachRow.Visible then h = h + 24 end
		if S.invShowFull and fullGrid.Visible then h = h + fullGrid.AbsoluteSize.Y + 8 end
		root.Size = UDim2.new(0, 640, 0, h)
		root.Position = UDim2.new(0.5, -320, 0, 20)
		root.Visible = true
	end

	RunService.RenderStepped:Connect(function()
		if pinnedPlayer then
			local char = pinnedPlayer.Character
			if char then
				render({kind="player", player=pinnedPlayer, character=char, name=pinnedPlayer.Name})
			else
				root.Visible = false
			end
			return
		end
		if not S.invEnabled or not isHoldingInv then root.Visible = false; return end
		render(findTarget())
	end)

	function self.setEnabled(on)
		S.invEnabled = on
		-- The viewer has one predictable, complete mode.
		S.invShowName, S.invShowValue, S.invShowFull = true, true, true
		S.invIncludeCorpse, S.invShowAttach = true, true
		S.invMaxAngleDeg, S.invMaxDistance = 30, 1000000000
		if not on then root.Visible = false end
	end
	function self.setPinnedPlayer(player) pinnedPlayer = player end
	function self.getItemValue(item) return getItemValue(item) end
	function self.getTotalValue(target) return getTotalValue(target) end
	function self.isCorpse(model) return isCorpse(model) end

	return self
end)()
-- ============================================================
-- GROUND ITEMS AND CORPSES ESP
-- ============================================================
local GroundESP = (function()
	local self = {}
	local entries = {}
	local lastScan, dirty = 0, true
	local storageInventories, nextStorageInventoryRefresh = {}, 0

	local function remove(entry)
		local drawing = entries[entry]
		if drawing then
			drawing.text:Remove()
			entries[entry] = nil
		end
	end

	local function getPosition(entry)
		if entry:IsA("BasePart") then return entry.Position end
		local part = entry:FindFirstChildWhichIsA("BasePart", true)
		-- Empty or dismantled models retain a stale pivot. Never draw from one.
		if not part then return nil end
		return entry:IsA("Model") and entry:GetPivot().Position or part.Position
	end

	local function getGroundValue(entry)
		local value = Inventory.getItemValue(entry)
		if value > 0 then return entry.Name, value end
		for _, child in ipairs(entry:GetDescendants()) do
			value = Inventory.getItemValue(child)
			if value > 0 then return child.Name, value end
		end
		return nil, 0
	end

	local function add(entry, kind, name, value)
		local text = Drawing.new("Text")
		text.Visible = false
		text.Center = true
		text.Outline = true
		text.OutlineColor = Color3.new(0, 0, 0)
		text.Size = 14
		entries[entry] = {text = text, kind = kind, name = name, value = value}
	end

	local containerWords = {
		"crate", "chest", "box", "bag", "cache", "container", "stash", "storage",
		"locker", "safe", "case", "register", "barrel", "supply", "loot", "pouch",
		"duffel", "briefcase", "suitcase", "backpack", "pack", "kgb",
	}

	local function hasContainerMarker(node)
		if node:GetAttribute("CanSpawnLoot") or node:GetAttribute("LootContainer")
			or node:GetAttribute("IsContainer") or node:GetAttribute("Container") then
			return true
		end
		local name = string.lower(node.Name)
		for _, word in ipairs(containerWords) do
			if string.find(name, word, 1, true) then return true end
		end
		return false
	end

	local function getContainerRoot(inventory)
		local character = inventory:FindFirstAncestorOfClass("Model")
		if character and (Players:GetPlayerFromCharacter(character) or Inventory.isCorpse(character)) then
			return character
		end
		local fallback, node = nil, inventory.Parent
		while node and node ~= Workspace do
			-- A model or part with an inventory is a valid physical container even
			-- when its creator used an arbitrary name. Prefer explicit markers.
			if getPosition(node) then
				if not fallback and (node:IsA("Model") or node:IsA("BasePart")) then fallback = node end
				if hasContainerMarker(node) then return node end
			end
			node = node.Parent
		end
		return fallback
	end

	local function getContainerSummary(inventory)
		local counts, total, visited = {}, 0, {}
		local function collect(current)
			if visited[current] then return end
			visited[current] = true
			for _, item in ipairs(current:GetChildren()) do
			local value = Inventory.getItemValue(item)
			-- Include the exact tracked items even if this client has no price data.
			if isTrackedLoot(item.Name) or (value > 0 and value >= S.groundMinValue) then
				local amount = item:GetAttribute("Amount")
				counts[item.Name] = (counts[item.Name] or 0) + (type(amount) == "number" and amount or 1)
				total = total + value
			end
				local nested = item:FindFirstChild("Inventory")
				if nested and (nested:IsA("Folder") or nested:IsA("Configuration")) then collect(nested) end
			end
		end
		collect(inventory)
		local names = {}
		for name, amount in pairs(counts) do
			table.insert(names, amount > 1 and (name .. " ×" .. amount) or name)
		end
		table.sort(names)
		if #names == 0 then return nil, 0 end
		local shown = {}
		for i = 1, math.min(#names, 4) do table.insert(shown, names[i]) end
		if #names > 4 then table.insert(shown, "+" .. (#names - 4) .. " more") end
		return table.concat(shown, ", "), total
	end

	local function isNestedInventory(inventory)
		local node = inventory.Parent
		while node and node ~= Workspace do
			if (node:IsA("Folder") or node:IsA("Configuration")) and string.lower(node.Name) == "inventory" then
				return true
			end
			node = node.Parent
		end
		return false
	end

	local function getStorageInventories()
		local now = os.clock()
		if now < nextStorageInventoryRefresh then return storageInventories end
		nextStorageInventoryRefresh = now + 5
		storageInventories = {}
		local storageRoot = Workspace:FindFirstChild("Containers")
		if not storageRoot then return storageInventories end
		for _, node in ipairs(storageRoot:GetDescendants()) do
			if (node:IsA("Folder") or node:IsA("Configuration"))
				and string.lower(node.Name) == "inventory" and not isNestedInventory(node) then
				table.insert(storageInventories, node)
			end
		end
		return storageInventories
	end

	local function scan()
		if not (S.groundItemEsp or S.corpseEsp) then
			for entry in pairs(entries) do remove(entry) end
			return
		end
		local folder = Workspace:FindFirstChild("DroppedItems")
		local found, alive = {}, {}
		if folder then
			for _, entry in ipairs(folder:GetChildren()) do
				local pos = getPosition(entry)
				if pos then
					alive[entry] = true
					if Inventory.isCorpse(entry) then
						if S.corpseEsp then
							local value = Inventory.getTotalValue(entry)
							found[entry] = true
							if not entries[entry] then add(entry, "corpse", entry.Name, value) end
							entries[entry].value = value
						end
					else
						local name, value = getGroundValue(entry)
						if S.groundItemEsp and (isTrackedLoot(name or entry.Name) or (value > 0 and value >= S.groundMinValue)) then
							found[entry] = true
							if not entries[entry] then add(entry, "item", name or entry.Name, value) end
							entries[entry].name, entries[entry].value = name or entry.Name, value
						end
					end
				end
			end
		end
		if S.groundItemEsp then
			-- All map storage in this experience lives below Workspace.Containers.
			-- Avoid walking NPC zones and the entire map every refresh.
			for _, inventory in ipairs(getStorageInventories()) do
				if inventory.Parent then
					local container = getContainerRoot(inventory)
					local summary, value = container and getContainerSummary(inventory)
					if container and summary and getPosition(container) then
						alive[container] = true
						found[container] = true
						local label = container:GetAttribute("DisplayName") or container.Name
						local player = Players:GetPlayerFromCharacter(container)
						if player then label = player.Name end
						label = label .. "\n" .. summary
						if not entries[container] then add(container, "container", label, value or 0) end
						entries[container].name, entries[container].value = label, value or 0
					end
				end
			end
		end
		-- In this game, player inventories are replicated under ReplicatedStorage
		-- rather than necessarily below the character model. Anchor them to the
		-- character so valuable loot on people is visible in the world as well.
		if S.groundItemEsp then
			local records = ReplicatedStorage:FindFirstChild("Players")
			if records then
				for _, player in ipairs(Players:GetPlayers()) do
					if player ~= LocalPlayer then
						local inventory = records:FindFirstChild(player.Name)
							and records[player.Name]:FindFirstChild("Inventory")
						local character = player.Character
						local summary, value = inventory and getContainerSummary(inventory)
						if character and summary and getPosition(character) then
							alive[character] = true
							found[character] = true
							local label = player.Name .. "\n" .. summary
							if not entries[character] then add(character, "container", label, value) end
							entries[character].kind, entries[character].name, entries[character].value = "container", label, value
						end
					end
				end
			end
		end
		for entry in pairs(entries) do if not found[entry] then remove(entry) end end
		dirty = false
	end

	local boundDroppedFolder
	local function bindDroppedFolder()
		local folder = Workspace:FindFirstChild("DroppedItems")
		if folder == boundDroppedFolder then return end
		boundDroppedFolder = folder; dirty = true
		if folder then
			folder.ChildAdded:Connect(function() dirty = true end)
			folder.ChildRemoved:Connect(function() dirty = true end)
		end
	end
	Workspace.ChildAdded:Connect(bindDroppedFolder)
	Workspace.ChildRemoved:Connect(bindDroppedFolder)
	bindDroppedFolder()

	RunService.RenderStepped:Connect(function()
		bindDroppedFolder()
		if dirty or os.clock() - lastScan >= 1.25 then lastScan = os.clock(); scan() end
		local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		for entry, data in pairs(entries) do
			local pos = entry.Parent and getPosition(entry)
			if not pos then
				remove(entry)
			else
				local point, onScreen = Camera:WorldToViewportPoint(pos)
				local distance = myRoot and math.floor((myRoot.Position - pos).Magnitude * 0.28) or 0
				data.text.Visible = onScreen and point.Z > 0
				data.text.Position = Vector2.new(point.X, point.Y)
				data.text.Color = data.kind == "corpse" and C.CORPSE or (data.kind == "container" and C.CONTAINER or C.GROUND_ITEM)
				if data.kind == "container" then
					data.text.Text = data.value > 0
						and string.format("%s\n$%d | %dm", data.name, math.floor(data.value), distance)
						or string.format("%s\n[%dm]", data.name, distance)
				else
					data.text.Text = string.format("%s | $%d | %dm", data.name, math.floor(data.value), distance)
				end
			end
		end
	end)

	function self.setGroundItems(on) S.groundItemEsp = on; scan() end
	function self.setCorpses(on) S.corpseEsp = on; scan() end
	function self.setMinValue(value) S.groundMinValue = value; scan() end
	function self.refresh() dirty = true; scan() end

	return self
end)()

-- MAP OBJECT ESP (unlimited range; categories are intentionally opt-in)
local ObjectESP = (function()
	local self = {}
	local drawings, lastScan = {}, 0
	local SCAN_INTERVAL = 3
	local keywords = {
		{"medical", {"medkit", "bandage", "dressing", "ifak", "serum", "morphine"}},
		{"armor", {"helmet", "armor", "vest", "chest", "rig", "pads", "mask"}},
		{"attachment", {"scope", "sight", "muzzle", "suppressor", "grip", "stock"}},
		{"ammo", {"ammo", "bullet", "round", "magazine", "mag_", "9mm", "556", "762", "shell"}},
		{"weapon", {"weapon", "gun", "rifle", "pistol", "shotgun", "smg", "sniper", "revolver", "rpg", "ak", "m4"}},
		{"tool", {"tool", "wrench", "hammer", "axe", "pickaxe", "saw"}},
		{"food", {"water", "food", "beans", "milk", "cola", "drink", "jerky"}},
		{"key", {"key", "keycard", "card"}},
	}

	local function remove(instance)
		local drawing = drawings[instance]
		if drawing then drawing:Remove(); drawings[instance] = nil end
	end

	local function categoryFor(instance)
		local exactName = string.lower(instance.Name)
		if exactName == "rubles" then return "currency" end
		local text = string.lower(instance.Name .. " " .. tostring(instance:GetAttribute("DisplayName") or "") .. " " .. tostring(instance:GetAttribute("ItemType") or ""))
		for _, rule in ipairs(keywords) do
			local category, words = rule[1], rule[2]
			for _, word in ipairs(words) do if string.find(text, word, 1, true) then return category end end
		end
		if instance:IsA("Tool") or instance:GetAttribute("ItemType") or instance:GetAttribute("DisplayName") then return "misc" end
		return nil
	end

	local function getPosition(instance)
		if instance:IsA("BasePart") then return instance.Position end
		local part = instance:FindFirstChildWhichIsA("BasePart", true)
		if not part then return nil end
		return instance:IsA("Model") and instance:GetPivot().Position or part.Position
	end

	local function isEnabled(category)
		return (category == "ammo" and S.objectAmmo)
			or (category == "weapon" and S.objectWeapons)
			or (category == "tool" and S.objectTools)
			or (category == "misc" and S.objectMisc)
			or (category == "medical" and S.objectMedical) or (category == "armor" and S.objectArmor)
			or (category == "food" and S.objectFood) or (category == "key" and S.objectKeys)
			or (category == "attachment" and S.objectAttachments)
			or (category == "currency" and S.objectRubles)
	end

	local function scan()
		local anyCategory = S.objectAmmo or S.objectWeapons or S.objectMisc or S.objectTools
			or S.objectMedical or S.objectArmor or S.objectFood or S.objectKeys or S.objectAttachments
		if not (S.objectRubles or (S.objectEsp and anyCategory)) then
			for instance in pairs(drawings) do remove(instance) end
			return
		end
		local found = {}
		local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		for _, instance in ipairs(Workspace:GetDescendants()) do
			if instance:IsA("Model") or instance:IsA("Tool") or instance:IsA("BasePart") then
				-- A model is labeled once instead of once for every internal part.
				local parentModel = instance:FindFirstAncestorOfClass("Model")
				if not (instance:IsA("BasePart") and parentModel) then
					local category = categoryFor(instance)
					local position = getPosition(instance)
					local inRange = position and (not myRoot or S.objectEspDistance <= 0
						or (myRoot.Position - position).Magnitude * 0.28 <= S.objectEspDistance)
					if category and isEnabled(category) and inRange then
						found[instance] = category
						if not drawings[instance] then
							local text = Drawing.new("Text")
							text.Visible = false; text.Center = true; text.Outline = true
							text.OutlineColor = Color3.new(0, 0, 0); text.Size = 13
							drawings[instance] = text
						end
					end
				end
			end
		end
		for instance in pairs(drawings) do if not found[instance] then remove(instance) end end
		return found
	end

	RunService.RenderStepped:Connect(function()
		if os.clock() - lastScan >= SCAN_INTERVAL then lastScan = os.clock(); scan() end
		local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		for instance, text in pairs(drawings) do
			local pos = instance.Parent and getPosition(instance)
			if not pos then remove(instance) else
				local point, onScreen = Camera:WorldToViewportPoint(pos)
				text.Visible = onScreen and point.Z > 0
				local distance = myRoot and math.floor((myRoot.Position - pos).Magnitude * 0.28) or 0
				local priority = categoryFor(instance)
				text.Visible = onScreen and point.Z > 0 and (S.objectEspDistance <= 0 or distance <= S.objectEspDistance)
				if text.Visible then
					text.Position = Vector2.new(point.X, point.Y)
					text.Color = priority == "currency" and C.GROUND_ITEM or Color3.fromRGB(80, 190, 255)
					local amount = instance:GetAttribute("Amount")
					local suffix = priority == "currency" and type(amount) == "number" and (" ×" .. math.floor(amount)) or ""
					text.Text = string.format("%s%s | %dm", instance.Name, suffix, distance)
				end
			end
		end
	end)

	function self.refresh() scan() end
	function self.setEnabled(on) S.objectEsp = on; scan() end
	function self.setCategory(category, on)
		if category == "ammo" then S.objectAmmo = on
		elseif category == "weapon" then S.objectWeapons = on
		elseif category == "misc" then S.objectMisc = on
		elseif category == "tool" then S.objectTools = on end
		if category == "medical" then S.objectMedical = on elseif category == "armor" then S.objectArmor = on
		elseif category == "food" then S.objectFood = on elseif category == "key" then S.objectKeys = on
		elseif category == "attachment" then S.objectAttachments = on end
		if category == "currency" then S.objectRubles = on end
		scan()
	end
	function self.setDistance(value) S.objectEspDistance = value end
	return self
end)()
-- ============================================================
-- MAP OBJECT FINDER (read-only)
-- ============================================================
local WorldSearch = (function()
	local self = {}
	local activeHighlight, activeMarker, focusToken = nil, nil, 0

	local function getRoot(scope)
		if scope == "Containers" then return Workspace:FindFirstChild("Containers") end
		if scope == "Dropped Items" then return Workspace:FindFirstChild("DroppedItems") end
		return Workspace
	end

	local function getPosition(instance)
		if instance:IsA("BasePart") then return instance.Position end
		local part = instance:FindFirstChildWhichIsA("BasePart", true)
		if not part then return nil end
		return instance:IsA("Model") and instance:GetPivot().Position or part.Position
	end

	local function matchesName(name, displayName, query)
		name = string.lower(name or "")
		displayName = string.lower(displayName or "")
		for word in string.gmatch(string.lower(query), "%S+") do
			if not string.find(name, word, 1, true) and not string.find(displayName, word, 1, true) then
				return false
			end
		end
		return true
	end

	local function inventoryAnchor(inventory)
		local model = inventory:FindFirstAncestorOfClass("Model")
		local player = model and Players:GetPlayerFromCharacter(model)
		if player then
			return model:FindFirstChild("HumanoidRootPart"), "Player: " .. player.Name, "Players"
		end
		local node = inventory.Parent
		while node and node ~= Workspace do
			if node:IsA("Model") or node:IsA("BasePart") then
				if getPosition(node) then return node, node:GetAttribute("DisplayName") or node.Name, "Containers" end
			end
			node = node.Parent
		end
		return nil, nil, nil
	end

	-- Searches actual loot entries, including player inventories and every
	-- replicated map-container inventory. The result anchors to its owner so a
	-- name/tracer can point to a physical world position.
	function self.search(query, scope)
		query = tostring(query or ""):gsub("^%s*(.-)%s*$", "%1")
		if query == "" then return {}, 0, "Enter a loot name to search." end

		local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		local results, seen = {}, {}
		local function add(itemName, displayName, anchor, location, category)
			if not anchor or not getPosition(anchor) or not matchesName(itemName, displayName, query) then return end
			if scope ~= "All Loot" and scope ~= category then return end
			local key = tostring(anchor) .. "|" .. itemName
			if seen[key] then return end
			seen[key] = true
			local position = getPosition(anchor)
			local distance = myRoot and (myRoot.Position - position).Magnitude * 0.28 or nil
			table.insert(results, {instance=anchor, lootName=itemName, location=location, distance=distance})
		end

		for _, inventory in ipairs(Workspace:GetDescendants()) do
			if (inventory:IsA("Folder") or inventory:IsA("Configuration")) and string.lower(inventory.Name) == "inventory" then
				local anchor, location, category = inventoryAnchor(inventory)
				for _, item in ipairs(inventory:GetChildren()) do
					add(item.Name, item:GetAttribute("DisplayName"), anchor, location, category)
				end
			end
		end
		if scope == "All Loot" or scope == "Players" then
			local records = ReplicatedStorage:FindFirstChild("Players")
			if records then
				for _, player in ipairs(Players:GetPlayers()) do
					local record = records:FindFirstChild(player.Name)
					local inventory = record and record:FindFirstChild("Inventory")
					local anchor = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
					if inventory then
						for _, item in ipairs(inventory:GetChildren()) do
							add(item.Name, item:GetAttribute("DisplayName"), anchor, "Player: " .. player.Name, "Players")
						end
					end
				end
			end
		end
		if scope == "All Loot" or scope == "Dropped Items" then
			local dropped = Workspace:FindFirstChild("DroppedItems")
			if dropped then
				for _, instance in ipairs(dropped:GetDescendants()) do
					if instance:IsA("Model") or instance:IsA("Tool") or instance:IsA("BasePart") then
						add(instance.Name, instance:GetAttribute("DisplayName"), instance, "Dropped Items", "Dropped Items")
					end
				end
			end
		end
		table.sort(results, function(a, b)
			return (a.distance or math.huge) < (b.distance or math.huge)
		end)
		return results, #results, nil
	end

	local function clearMarker()
		if activeMarker and activeMarker.drawing then activeMarker.drawing:Remove() end
		activeMarker = nil
	end

	RunService.RenderStepped:Connect(function()
		if not activeMarker or not activeMarker.instance or not activeMarker.instance.Parent then return end
		local position = getPosition(activeMarker.instance)
		if not position then clearMarker(); return end
		local point, onScreen = Camera:WorldToViewportPoint(position)
		local drawing = activeMarker.drawing
		drawing.Visible = onScreen and point.Z > 0
		if drawing.Visible then
			if activeMarker.mode == "Tracer" then
				drawing.From = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y - 8)
				drawing.To = Vector2.new(point.X, point.Y)
			else
				drawing.Position = Vector2.new(point.X, point.Y)
			end
		end
	end)

	function self.focus(instance, mode)
		if activeHighlight then activeHighlight:Destroy(); activeHighlight = nil end
		clearMarker()
		if not instance or not instance.Parent then return end
		local adornee = instance
		if not adornee:IsA("Model") and not adornee:IsA("BasePart") then return end
		focusToken = focusToken + 1
		local highlight = Instance.new("Highlight")
		highlight.Name = "DeltaObjectSearchFocus"
		highlight.Adornee = adornee
		highlight.FillColor = Color3.fromRGB(74, 190, 255)
		highlight.OutlineColor = Color3.new(1, 1, 1)
		highlight.FillTransparency = 0.5
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = adornee
		activeHighlight = highlight
		local drawing = Drawing.new(mode == "Tracer" and "Line" or "Text")
		drawing.Visible = false
		drawing.Color = Color3.fromRGB(195, 90, 255)
		drawing.Thickness = 2
		if mode ~= "Tracer" then
			drawing.Text = instance.Name
			drawing.Size = 15
			drawing.Center = true
			drawing.Outline = true
			drawing.OutlineColor = Color3.new(0, 0, 0)
		end
		activeMarker = {instance=instance, mode=mode, drawing=drawing}
		-- The marker remains until the user clears it or selects another result.
	end

	function self.clearFocus()
		focusToken = focusToken + 1
		if activeHighlight then activeHighlight:Destroy(); activeHighlight = nil end
		clearMarker()
	end

	return self
end)()
