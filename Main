local function destroyHub()
	if hubDestroyed then return end
	hubDestroyed = true
	isHolding = false; isHoldingInv = false
	Aimbot.destroy()
	ESP.stopESP(); ESP.stopSkeleton(); ESP.stopTracer()
	NPCEsp.stopESP(); NPCEsp.stopSkeleton(); NPCEsp.stopTracer()
	Glow.setPlayerGlow(false); Glow.setNpcGlow(false)
	Footsteps.setEnabled(false)
	GroundESP.setGroundItems(false); GroundESP.setCorpses(false)
	ObjectESP.setEnabled(false)
	ObjectESP.setCategory("currency", false)
	WorldSearch.clearFocus()
	Freecam.stop()
	if freecamOverlay then freecamOverlay:Destroy() end
	PlayerList.setEnabled(false)
	AdminTools.stopSpectating()
	World.setFullbright(false); World.setNoFog(false)
	VM.setVMEnabled(false); VM.setWpnEnabled(false)
	Inventory.setEnabled(false); Inventory.setPinnedPlayer(nil)
	RunService:UnbindFromRenderStep("FOVLock")
	RunService:UnbindFromRenderStep("CheatViewModel")
	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	if playerGui then
		for _, name in ipairs({"InventoryHUD", "PlayerList"}) do
			local existing = playerGui:FindFirstChild(name)
			if existing then existing:Destroy() end
		end
	end
	Shared.DeltaHubCleanup = nil
	gui:Destroy()
end

Shared.DeltaHubCleanup = destroyHub

addSection("Hub")
