end

local function addToggle(name, default, callback)
	local parent = getCurrentContainer(); if not parent then return {Set=function()end} end
	local c = Instance.new("Frame", parent)
	c.Size = UDim2.new(1, -6, 0, 36); c.BackgroundColor3 = THEME.card
	c.BorderSizePixel = 0
	Instance.new("UICorner", c).CornerRadius = UDim.new(0, 6)
	c.LayoutOrder = #parent:GetChildren() + 1

	local lbl = Instance.new("TextLabel", c)
	lbl.Size = UDim2.new(1, -70, 1, 0); lbl.Position = UDim2.new(0, 12, 0, 0)
	lbl.BackgroundTransparency = 1; lbl.Text = name
	lbl.TextColor3 = THEME.text; lbl.Font = Enum.Font.GothamMedium
	lbl.TextSize = 13; lbl.TextXAlignment = Enum.TextXAlignment.Left

	local btn = Instance.new("TextButton", c)
	btn.Size = UDim2.new(0, 40, 0, 20); btn.Position = UDim2.new(1, -52, 0.5, -10)
	btn.BackgroundColor3 = Color3.fromRGB(55,55,70); btn.Text = ""
	btn.BorderSizePixel = 0; btn.AutoButtonColor = false
	Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

	local ind = Instance.new("Frame", btn)
	ind.Size = UDim2.new(0, 16, 0, 16); ind.Position = UDim2.new(0, 2, 0, 2)
	ind.BackgroundColor3 = Color3.fromRGB(220,220,225); ind.BorderSizePixel = 0
	Instance.new("UICorner", ind).CornerRadius = UDim.new(1, 0)

	local enabled = false
	local function setState(state, fire)
		enabled = state
		if state then
			TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = THEME.accent}):Play()
			TweenService:Create(ind, TweenInfo.new(0.15), {Position = UDim2.new(1, -18, 0, 2)}):Play()
		else
			TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(55,55,70)}):Play()
			TweenService:Create(ind, TweenInfo.new(0.15), {Position = UDim2.new(0, 2, 0, 2)}):Play()
		end
		if fire ~= false then callback(state) end
	end
	btn.MouseButton1Click:Connect(function() setState(not enabled) end)
	if default then setState(true, false) end
	return { Set = function(v, fire) setState(v, fire) end }
end

local function addSlider(name, minVal, maxVal, defaultVal, decimals, callback)
	local parent = getCurrentContainer(); if not parent then return {Set=function()end} end
	local c = Instance.new("Frame", parent)
	c.Size = UDim2.new(1, -6, 0, 44); c.BackgroundColor3 = THEME.card
	c.BorderSizePixel = 0
	Instance.new("UICorner", c).CornerRadius = UDim.new(0, 6)
	c.LayoutOrder = #parent:GetChildren() + 1

	local lbl = Instance.new("TextLabel", c)
	lbl.Size = UDim2.new(1, -80, 0, 18); lbl.Position = UDim2.new(0, 12, 0, 4)
	lbl.BackgroundTransparency = 1; lbl.Text = name
	lbl.TextColor3 = THEME.text; lbl.Font = Enum.Font.GothamMedium
	lbl.TextSize = 12; lbl.TextXAlignment = Enum.TextXAlignment.Left

	local valLbl = Instance.new("TextLabel", c)
	valLbl.Size = UDim2.new(0, 60, 0, 18); valLbl.Position = UDim2.new(1, -72, 0, 4)
	valLbl.BackgroundTransparency = 1; valLbl.TextColor3 = THEME.accent
	valLbl.Font = Enum.Font.GothamBold; valLbl.TextSize = 12
	valLbl.TextXAlignment = Enum.TextXAlignment.Right

	local bar = Instance.new("Frame", c)
	bar.Size = UDim2.new(1, -24, 0, 4); bar.Position = UDim2.new(0, 12, 1, -14)
	bar.BackgroundColor3 = Color3.fromRGB(50,50,62); bar.BorderSizePixel = 0
	Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

	local fill = Instance.new("Frame", bar)
	fill.Size = UDim2.new(0, 0, 1, 0); fill.BackgroundColor3 = THEME.accent
	fill.BorderSizePixel = 0
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local knob = Instance.new("Frame", bar)
	knob.Size = UDim2.new(0, 12, 0, 12); knob.Position = UDim2.new(0, -6, 0.5, -6)
	knob.BackgroundColor3 = Color3.new(1,1,1); knob.BorderSizePixel = 0
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local hit = Instance.new("TextButton", bar)
	hit.Size = UDim2.new(1, 0, 0, 16); hit.Position = UDim2.new(0, 0, 0.5, -8)
	hit.BackgroundTransparency = 1; hit.Text = ""

	local currentValue = defaultVal
	local draggingSlider = false

	local function fmt(v)
		return decimals and string.format("%." .. decimals .. "f", v) or tostring(math.floor(v))
	end
	local function setValue(value, fire)
		value = math.clamp(value, minVal, maxVal)
		currentValue = value
		local fraction = (maxVal == minVal) and 0 or (value - minVal) / (maxVal - minVal)
		fill.Size = UDim2.new(fraction, 0, 1, 0)
		knob.Position = UDim2.new(fraction, -6, 0.5, -6)
		valLbl.Text = fmt(value)
		if fire ~= false then callback(value) end
	end

	hit.MouseButton1Down:Connect(function() draggingSlider = true end)
	hit.MouseButton1Up:Connect(function() draggingSlider = false end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = false end
	end)
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			local mp = UserInputService:GetMouseLocation()
			local ba = bar.AbsolutePosition
			local bs = bar.AbsoluteSize.X
			if bs <= 0 then return end
			setValue(minVal + ((mp.X - ba.X) / bs) * (maxVal - minVal))
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
			local ba = bar.AbsolutePosition
			local bs = bar.AbsoluteSize.X
			if bs <= 0 then return end
			setValue(minVal + ((input.Position.X - ba.X) / bs) * (maxVal - minVal))
		end
	end)
	setValue(defaultVal, false)
	return { Set = setValue, Get = function() return currentValue end }
end

local function addButton(text, color, callback)
	local parent = getCurrentContainer(); if not parent then return end
	local btn = Instance.new("TextButton", parent)
	btn.Size = UDim2.new(1, -6, 0, 30)
	btn.BackgroundColor3 = color or THEME.card
	btn.Text = text; btn.TextColor3 = THEME.text
	btn.Font = Enum.Font.GothamMedium; btn.TextSize = 13
	btn.BorderSizePixel = 0; btn.AutoButtonColor = false
	btn.LayoutOrder = #parent:GetChildren() + 1
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = (color or THEME.card):Lerp(Color3.new(1,1,1), 0.1)}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = color or THEME.card}):Play()
	end)
	btn.MouseButton1Click:Connect(callback)
	return btn
end

local function addTextInput(placeholder, initial, onSubmitted)
	local parent = getCurrentContainer(); if not parent then return nil end
	local input = Instance.new("TextBox", parent)
	input.Size = UDim2.new(1, -6, 0, 34)
	input.BackgroundColor3 = THEME.card
	input.BorderSizePixel = 0
	input.ClearTextOnFocus = false
	input.PlaceholderText = placeholder
	input.PlaceholderColor3 = THEME.textDim
	input.Text = initial or ""
	input.TextColor3 = THEME.text
	input.Font = Enum.Font.GothamMedium
	input.TextSize = 13
	input.TextXAlignment = Enum.TextXAlignment.Left
	input.LayoutOrder = #parent:GetChildren() + 1
	Instance.new("UICorner", input).CornerRadius = UDim.new(0, 6)
	local padding = Instance.new("UIPadding", input)
	padding.PaddingLeft = UDim.new(0, 12)
	padding.PaddingRight = UDim.new(0, 12)
	input.FocusLost:Connect(function(enterPressed)
		if enterPressed and onSubmitted then onSubmitted(input.Text) end
	end)
	return input
end

local function addKeyBind(label, getKeyName, onPicked)
	local parent = getCurrentContainer(); if not parent then return end
	local c = Instance.new("Frame", parent)
	c.Size = UDim2.new(1, -6, 0, 36); c.BackgroundColor3 = THEME.card
	c.BorderSizePixel = 0
	Instance.new("UICorner", c).CornerRadius = UDim.new(0, 6)
	c.LayoutOrder = #parent:GetChildren() + 1

	local lbl = Instance.new("TextLabel", c)
	lbl.Size = UDim2.new(0, 130, 1, 0); lbl.Position = UDim2.new(0, 12, 0, 0)
	lbl.BackgroundTransparency = 1; lbl.Text = label
	lbl.TextColor3 = THEME.text; lbl.Font = Enum.Font.GothamMedium
	lbl.TextSize = 13; lbl.TextXAlignment = Enum.TextXAlignment.Left

	local valLbl = Instance.new("TextLabel", c)
	valLbl.Size = UDim2.new(0, 80, 1, 0); valLbl.Position = UDim2.new(0, 148, 0, 0)
	valLbl.BackgroundTransparency = 1; valLbl.Text = getKeyName()
	valLbl.TextColor3 = THEME.accent; valLbl.Font = Enum.Font.GothamBold
	valLbl.TextSize = 13; valLbl.TextXAlignment = Enum.TextXAlignment.Left

	local btn = Instance.new("TextButton", c)
	btn.Size = UDim2.new(0, 60, 0, 24); btn.Position = UDim2.new(1, -72, 0.5, -12)
	btn.BackgroundColor3 = THEME.accent
	btn.Text = "Set"
	btn.TextColor3 = Color3.new(1,1,1); btn.Font = Enum.Font.GothamMedium
	btn.TextSize = 12; btn.BorderSizePixel = 0; btn.AutoButtonColor = false
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

	btn.MouseButton1Click:Connect(function()
		btn.Text = "..."
		pendingKeybind = function(input)
			if input.UserInputType == Enum.UserInputType.Keyboard then
				onPicked({type = "key", code = input.KeyCode})
			elseif input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.MouseButton2
				or input.UserInputType == Enum.UserInputType.MouseButton3 then
				onPicked({type = "mouse", code = input.UserInputType})
			else
				return false
			end
			valLbl.Text = getKeyName()
			btn.Text = "Set"
			return true
		end
	end)
	return {Set = function()
		valLbl.Text = getKeyName()
		btn.Text = "Set"
	end}
end

-- HSV PICKER
local currentPicker = nil
local pickerDragConns = {}

local function closePicker()
	if currentPicker then currentPicker:Destroy(); currentPicker = nil end
	for _, c in ipairs(pickerDragConns) do c:Disconnect() end
	pickerDragConns = {}
end

local function openColorPicker(anchorButton, initialColor, callback)
	if currentPicker then closePicker() end
	local h, s, v = Color3.toHSV(initialColor)

	local picker = Instance.new("Frame", gui)
	picker.Size = UDim2.new(0, 220, 0, 260)
	picker.BackgroundColor3 = THEME.card
	picker.BorderSizePixel = 0
	picker.ZIndex = 250
	Instance.new("UICorner", picker).CornerRadius = UDim.new(0, 8)
	Instance.new("UIStroke", picker).Color = THEME.stroke

	local absPos = anchorButton.AbsolutePosition
	local absSize = anchorButton.AbsoluteSize
	local screenSize = Camera.ViewportSize
	local px = absPos.X + absSize.X + 8
	local py = absPos.Y
	if px + 220 > screenSize.X then px = absPos.X - 228 end
	if py + 260 > screenSize.Y then py = screenSize.Y - 268 end
	if py < 0 then py = 0 end
	picker.Position = UDim2.new(0, px, 0, py)

	local svSquare = Instance.new("Frame", picker)
	svSquare.Size = UDim2.new(1, -20, 0, 160); svSquare.Position = UDim2.new(0, 10, 0, 10)
	svSquare.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
	svSquare.BorderSizePixel = 0
	Instance.new("UICorner", svSquare).CornerRadius = UDim.new(0, 6)

	local satOverlay = Instance.new("Frame", svSquare)
	satOverlay.Size = UDim2.new(1, 0, 1, 0); satOverlay.BackgroundColor3 = Color3.new(1,1,1)
	satOverlay.BorderSizePixel = 0; satOverlay.ZIndex = svSquare.ZIndex + 1
	Instance.new("UICorner", satOverlay).CornerRadius = UDim.new(0, 6)
	local satGrad = Instance.new("UIGradient", satOverlay)
	satGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})

	local valOverlay = Instance.new("Frame", svSquare)
	valOverlay.Size = UDim2.new(1, 0, 1, 0); valOverlay.BackgroundColor3 = Color3.new(0,0,0)
	valOverlay.BorderSizePixel = 0; valOverlay.ZIndex = svSquare.ZIndex + 2
	Instance.new("UICorner", valOverlay).CornerRadius = UDim.new(0, 6)
	local valGrad = Instance.new("UIGradient", valOverlay)
	valGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0),
	})
	valGrad.Rotation = 90

	local svCursor = Instance.new("Frame", svSquare)
	svCursor.Size = UDim2.new(0, 12, 0, 12); svCursor.Position = UDim2.new(s, -6, 1-v, -6)
	svCursor.BackgroundColor3 = Color3.new(1,1,1); svCursor.BorderSizePixel = 0
	svCursor.ZIndex = svSquare.ZIndex + 3
	Instance.new("UICorner", svCursor).CornerRadius = UDim.new(1, 0)
	Instance.new("UIStroke", svCursor).Color = Color3.new(0,0,0)

	local svHitbox = Instance.new("TextButton", svSquare)
	svHitbox.Size = UDim2.new(1, 0, 1, 0); svHitbox.BackgroundTransparency = 1
	svHitbox.Text = ""; svHitbox.ZIndex = svSquare.ZIndex + 4

	local hueBar = Instance.new("Frame", picker)
	hueBar.Size = UDim2.new(1, -20, 0, 18); hueBar.Position = UDim2.new(0, 10, 0, 178)
	hueBar.BackgroundColor3 = Color3.new(1,1,1); hueBar.BorderSizePixel = 0
	Instance.new("UICorner", hueBar).CornerRadius = UDim.new(0, 6)

	local hueGrad = Instance.new("UIGradient", hueBar)
	hueGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.000, Color3.fromRGB(255,0,0)),
		ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255,255,0)),
		ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0,255,0)),
		ColorSequenceKeypoint.new(0.500, Color3.fromRGB(0,255,255)),
		ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0,0,255)),
		ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255,0,255)),
		ColorSequenceKeypoint.new(1.000, Color3.fromRGB(255,0,0)),
	})

	local hueCursor = Instance.new("Frame", hueBar)
	hueCursor.Size = UDim2.new(0, 4, 1, 4); hueCursor.Position = UDim2.new(h, -2, 0, -2)
	hueCursor.BackgroundColor3 = Color3.new(1,1,1); hueCursor.BorderSizePixel = 0
	hueCursor.ZIndex = hueBar.ZIndex + 2
	Instance.new("UIStroke", hueCursor).Color = Color3.new(0,0,0)

	local hueHitbox = Instance.new("TextButton", hueBar)
	hueHitbox.Size = UDim2.new(1, 0, 1, 0); hueHitbox.BackgroundTransparency = 1
	hueHitbox.Text = ""; hueHitbox.ZIndex = hueBar.ZIndex + 3

	local preview = Instance.new("Frame", picker)
	preview.Size = UDim2.new(1, -20, 0, 24); preview.Position = UDim2.new(0, 10, 0, 204)
	preview.BackgroundColor3 = initialColor; preview.BorderSizePixel = 0
	Instance.new("UICorner", preview).CornerRadius = UDim.new(0, 4)
	Instance.new("UIStroke", preview).Color = THEME.stroke

	local hexLbl = Instance.new("TextLabel", preview)
	hexLbl.Size = UDim2.new(1, 0, 1, 0); hexLbl.BackgroundTransparency = 1
	hexLbl.TextColor3 = Color3.new(1,1,1); hexLbl.Font = Enum.Font.GothamBold
	hexLbl.TextSize = 13

	local function emit()
		local col = Color3.fromHSV(h, s, v)
		preview.BackgroundColor3 = col
		hexLbl.Text = string.format("#%02X%02X%02X",
			math.floor(col.R * 255), math.floor(col.G * 255), math.floor(col.B * 255))
		callback(col)
	end

	local function updateFromSV(mx, my)
		local a = svSquare.AbsolutePosition; local sz = svSquare.AbsoluteSize
		s = math.clamp((mx - a.X) / sz.X, 0, 1)
		v = 1 - math.clamp((my - a.Y) / sz.Y, 0, 1)
		svCursor.Position = UDim2.new(s, -6, 1-v, -6)
		emit()
	end

	local function updateFromHue(mx)
		local a = hueBar.AbsolutePosition; local sz = hueBar.AbsoluteSize
		h = math.clamp((mx - a.X) / sz.X, 0, 1)
		hueCursor.Position = UDim2.new(h, -2, 0, -2)
		svSquare.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		emit()
	end

	svHitbox.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			updateFromSV(input.Position.X, input.Position.Y)
			local c1; c1 = UserInputService.InputChanged:Connect(function(inp)
				if inp.UserInputType == Enum.UserInputType.MouseMovement then
					updateFromSV(inp.Position.X, inp.Position.Y)
				end
			end)
			table.insert(pickerDragConns, c1)
			local c2; c2 = UserInputService.InputEnded:Connect(function(inp)
				if inp.UserInputType == Enum.UserInputType.MouseButton1 then
					c1:Disconnect(); c2:Disconnect()
				end
			end)
			table.insert(pickerDragConns, c2)
		end
	end)

	hueHitbox.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			updateFromHue(input.Position.X)
			local c1; c1 = UserInputService.InputChanged:Connect(function(inp)
				if inp.UserInputType == Enum.UserInputType.MouseMovement then
					updateFromHue(inp.Position.X)
				end
			end)
			table.insert(pickerDragConns, c1)
			local c2; c2 = UserInputService.InputEnded:Connect(function(inp)
				if inp.UserInputType == Enum.UserInputType.MouseButton1 then
					c1:Disconnect(); c2:Disconnect()
				end
			end)
			table.insert(pickerDragConns, c2)
		end
	end)

	local doneBtn = Instance.new("TextButton", picker)
	doneBtn.Size = UDim2.new(1, -20, 0, 26); doneBtn.Position = UDim2.new(0, 10, 0, 232)
	doneBtn.BackgroundColor3 = THEME.accent; doneBtn.Text = "Done"
	doneBtn.TextColor3 = Color3.new(1,1,1); doneBtn.Font = Enum.Font.GothamBold
	doneBtn.TextSize = 13; doneBtn.BorderSizePixel = 0; doneBtn.AutoButtonColor = false
	Instance.new("UICorner", doneBtn).CornerRadius = UDim.new(0, 6)
	doneBtn.MouseButton1Click:Connect(function() closePicker() end)

	currentPicker = picker
	emit()
end

local function addColorButton(label, getColor, callback)
	local parent = getCurrentContainer(); if not parent then return end
	local container = Instance.new("Frame", parent)
	container.Size = UDim2.new(1, -6, 0, 40)
	container.BackgroundColor3 = THEME.card; container.BorderSizePixel = 0
	Instance.new("UICorner", container).CornerRadius = UDim.new(0, 6)
	container.LayoutOrder = #parent:GetChildren() + 1

	local lbl = Instance.new("TextLabel", container)
	lbl.Size = UDim2.new(0, 120, 1, 0); lbl.Position = UDim2.new(0, 12, 0, 0)
	lbl.BackgroundTransparency = 1; lbl.Text = label
	lbl.TextColor3 = THEME.text; lbl.Font = Enum.Font.GothamMedium
	lbl.TextSize = 13; lbl.TextXAlignment = Enum.TextXAlignment.Left

	local swatch = Instance.new("TextButton", container)
	swatch.Size = UDim2.new(0, 60, 0, 26); swatch.Position = UDim2.new(1, -72, 0.5, -13)
	swatch.BackgroundColor3 = getColor()
	swatch.Text = ""; swatch.BorderSizePixel = 0; swatch.AutoButtonColor = false
	Instance.new("UICorner", swatch).CornerRadius = UDim.new(0, 6)
	Instance.new("UIStroke", swatch).Color = THEME.stroke

	swatch.MouseButton1Click:Connect(function()
		openColorPicker(swatch, swatch.BackgroundColor3, function(c)
			swatch.BackgroundColor3 = c
			callback(c)
		end)
	end)

	return {Set=function(color) swatch.BackgroundColor3 = color end}
end

local function addModeSwitch(label, options, getCurrent, onPick)
	local parent = getCurrentContainer(); if not parent then return end
	local c = Instance.new("Frame", parent)
	c.Size = UDim2.new(1, -6, 0, 36); c.BackgroundColor3 = THEME.card
	c.BorderSizePixel = 0
	Instance.new("UICorner", c).CornerRadius = UDim.new(0, 6)
	c.LayoutOrder = #parent:GetChildren() + 1

	local lbl = Instance.new("TextLabel", c)
	lbl.Size = UDim2.new(0, 120, 1, 0); lbl.Position = UDim2.new(0, 12, 0, 0)
	lbl.BackgroundTransparency = 1; lbl.Text = label
	lbl.TextColor3 = THEME.text; lbl.Font = Enum.Font.GothamMedium
	lbl.TextSize = 13; lbl.TextXAlignment = Enum.TextXAlignment.Left

	local btn = Instance.new("TextButton", c)
	btn.Size = UDim2.new(0, 110, 0, 24); btn.Position = UDim2.new(1, -122, 0.5, -12)
	btn.BackgroundColor3 = THEME.accent
	btn.Text = getCurrent()
	btn.TextColor3 = Color3.new(1,1,1); btn.Font = Enum.Font.GothamBold
	btn.TextSize = 12; btn.BorderSizePixel = 0; btn.AutoButtonColor = false
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

	local function paint(value)
		for _, opt in ipairs(options) do
			if opt.value == value then
				btn.Text = opt.label
				btn.BackgroundColor3 = opt.color or THEME.accent
				return
			end
		end
		btn.Text = tostring(value)
	end
	btn.MouseButton1Click:Connect(function()
		local cur, idx = getCurrent(), 1
		for i, opt in ipairs(options) do if opt.value == cur then idx = i; break end end
		idx = (idx % #options) + 1
		local picked = options[idx]
		btn.Text = picked.label
		btn.BackgroundColor3 = picked.color or THEME.accent
		onPick(picked.value)
	end)
	return {Set = function(value) paint(value) end}
end

-- CONFIGS
local HttpService = game:GetService("HttpService")
local UIControls = {}
local ColorControls = {}
local refreshTrackedLootUI = function() end
local function syncToggleControls()
	for setting, control in pairs(UIControls) do
		if control and control.Set then control:Set(S[setting], false) end
	end
	for name, control in pairs(ColorControls) do
		if control and control.Set and C[name] then control:Set(C[name]) end
	end
end

local function showConfigStatus(text)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "RobloxScriDev Delta HUB",
			Text = text,
			Duration = 4,
		})
	end)
end

local Configs = (function()
	local self = {}
	local CONFIG_DIR = "DeltaHubConfigs"

	local function configPath(name)
		return CONFIG_DIR .. "/" .. tostring(name) .. ".json"
	end

	local function valueOf(data, key, fallback)
		local value = data[key]
		return value == nil and fallback or value
	end

	local function SaveFile(name, str)
		if writefile then
			if makefolder and isfolder and not isfolder(CONFIG_DIR) then pcall(makefolder, CONFIG_DIR) end
			writefile(configPath(name), str)
			return true
		end
		return false
	end

	local function LoadFile(name)
		if isfile and readfile then
			local path = configPath(name)
			if isfile(path) then return readfile(path) end
			-- Compatibility with the old global .txt locations.
			local legacy = tostring(name) .. ".txt"
			if isfile(legacy) then return readfile(legacy) end
		end
		return nil
	end

	function self.collect()
		return {
			aimEnabled=S.aimEnabled, aimMode=S.aimMode, aimPart=S.aimPart,
			aimFov=S.aimFov, aimSmoothing=S.aimSmoothing, aimPrediction=S.aimPrediction,
			aimVisibleOnly=S.aimVisibleOnly, aimNPCs=S.aimNPCs, perfectSilent=S.perfectSilent,
			weaponPrediction=S.weaponPrediction, weaponAntiRecoil=S.weaponAntiRecoil, weaponRecoilStrength=S.weaponRecoilStrength, weaponDropScale=S.weaponDropScale,
			silentHitChance=S.silentHitChance,
			holdKeyType=S.holdKey.type, holdKeyName=S.holdKey.code.Name,
			aimActivationMode=S.aimActivationMode,
			espBox=S.espBox, espSkeleton=S.espSkeleton, espTracer=S.espTracer,
			espShowHeldItem=S.espShowHeldItem, espShowAiming=S.espShowAiming,
			npcEspBox=S.npcEspBox, npcEspSkeleton=S.npcEspSkeleton, npcEspTracer=S.npcEspTracer,
			playerGlow=S.playerGlow, npcGlow=S.npcGlow, glowTransparency=S.glowTransparency,
			footsteps=S.footsteps, footstepSize=S.footstepSize,
			playerList=S.playerList,
			groundItemEsp=S.groundItemEsp, corpseEsp=S.corpseEsp,
			groundMinValue=S.groundMinValue,
			objectEsp=S.objectEsp, objectAmmo=S.objectAmmo, objectWeapons=S.objectWeapons,
			objectMisc=S.objectMisc, objectTools=S.objectTools, objectMedical=S.objectMedical, objectArmor=S.objectArmor, objectFood=S.objectFood, objectKeys=S.objectKeys, objectAttachments=S.objectAttachments, objectEspDistance=S.objectEspDistance,
			objectRubles=S.objectRubles,
			trackedLootEnabled=S.trackedLootEnabled,
			freeCamSpeed=S.freeCamSpeed,
			fullbright=S.fullbright, noFog=S.noFog,
			dismissKeyName=S.dismissKey.Name,
			baseFov=S.baseFov, zoomFov=S.zoomFov, zoomKeyName=S.zoomKey.Name,
			vmEnabled=S.vmEnabled, vmTransparency=S.vmTransparency,
			vmOffsetX=S.vmOffsetX, vmOffsetY=S.vmOffsetY, vmOffsetZ=S.vmOffsetZ,
			vmColorR=S.vmColor.R, vmColorG=S.vmColor.G, vmColorB=S.vmColor.B,
			wpnEnabled=S.wpnEnabled, wpnTransparency=S.wpnTransparency,
			wpnColorR=S.wpnColor.R, wpnColorG=S.wpnColor.G, wpnColorB=S.wpnColor.B,
			invEnabled=S.invEnabled, invKeyName=S.invKey.Name,
			objectSearchScope=S.objectSearchScope,
			objectSearchMarker=S.objectSearchMarker,
			colors={
				ESP={C.ESP.R,C.ESP.G,C.ESP.B}, SKELETON={C.SKELETON.R,C.SKELETON.G,C.SKELETON.B},
				TRACER={C.TRACER.R,C.TRACER.G,C.TRACER.B}, AIM_FOV={C.AIM_FOV.R,C.AIM_FOV.G,C.AIM_FOV.B},
				GLOW={C.GLOW.R,C.GLOW.G,C.GLOW.B}, FOOTSTEP={C.FOOTSTEP.R,C.FOOTSTEP.G,C.FOOTSTEP.B},
				NPC_ESP={C.NPC_ESP.R,C.NPC_ESP.G,C.NPC_ESP.B}, NPC_SKELETON={C.NPC_SKELETON.R,C.NPC_SKELETON.G,C.NPC_SKELETON.B},
				NPC_TRACER={C.NPC_TRACER.R,C.NPC_TRACER.G,C.NPC_TRACER.B}, GROUND_ITEM={C.GROUND_ITEM.R,C.GROUND_ITEM.G,C.GROUND_ITEM.B},
				CORPSE={C.CORPSE.R,C.CORPSE.G,C.CORPSE.B}, VM_COLOR={C.VM_COLOR.R,C.VM_COLOR.G,C.VM_COLOR.B},
				WPN_COLOR={C.WPN_COLOR.R,C.WPN_COLOR.G,C.WPN_COLOR.B},
			},
		}
	end

	function self.apply(t)
		if not t then return end
		S.aimEnabled=valueOf(t, "aimEnabled", false); S.aimMode=valueOf(t, "aimMode", "Lock")
		S.aimPart=valueOf(t, "aimPart", "Head"); S.aimFov=valueOf(t, "aimFov", 90)
		S.aimSmoothing=valueOf(t, "aimSmoothing", 0.3); S.aimPrediction=valueOf(t, "aimPrediction", 0)
		S.aimVisibleOnly=valueOf(t, "aimVisibleOnly", false); S.aimNPCs=valueOf(t, "aimNPCs", false); S.perfectSilent=valueOf(t, "perfectSilent", false)
		S.weaponPrediction=valueOf(t, "weaponPrediction", false); S.weaponAntiRecoil=valueOf(t, "weaponAntiRecoil", false); S.weaponRecoilStrength=valueOf(t, "weaponRecoilStrength", 1); S.weaponDropScale=valueOf(t, "weaponDropScale", 0.05)
		S.silentHitChance=valueOf(t, "silentHitChance", 100)
		local code
		if t.holdKeyType == "mouse" then
			code = Enum.UserInputType[t.holdKeyName or "MouseButton1"] or Enum.UserInputType.MouseButton1
		else
			code = Enum.KeyCode[t.holdKeyName or "F"] or Enum.KeyCode.F
		end
		S.holdKey = {type=t.holdKeyType or "key", code=code}
		S.aimActivationMode = t.aimActivationMode or "Toggle"

		S.espBox=t.espBox or false; S.espSkeleton=t.espSkeleton or false; S.espTracer=t.espTracer or false
		S.espShowHeldItem=t.espShowHeldItem or false; S.espShowAiming=t.espShowAiming or false
		S.npcEspBox=t.npcEspBox or false; S.npcEspSkeleton=t.npcEspSkeleton or false; S.npcEspTracer=t.npcEspTracer or false

		S.playerGlow=t.playerGlow or false; S.npcGlow=t.npcGlow or false
		S.glowTransparency=valueOf(t, "glowTransparency", 0.5)

		S.footsteps=t.footsteps or false; S.footstepSize=t.footstepSize or 4

		S.playerList=t.playerList or false
		S.groundItemEsp=t.groundItemEsp or false; S.corpseEsp=t.corpseEsp or false
		S.containerContentsEsp=true
		S.groundMinValue=t.groundMinValue or 0
		S.objectEsp=valueOf(t, "objectEsp", false)
		S.objectAmmo=valueOf(t, "objectAmmo", false); S.objectWeapons=valueOf(t, "objectWeapons", false)
		S.objectMisc=valueOf(t, "objectMisc", false); S.objectTools=valueOf(t, "objectTools", false)
		S.objectMedical=valueOf(t, "objectMedical", false); S.objectArmor=valueOf(t, "objectArmor", false); S.objectFood=valueOf(t, "objectFood", false); S.objectKeys=valueOf(t, "objectKeys", false); S.objectAttachments=valueOf(t, "objectAttachments", false); S.objectEspDistance=valueOf(t, "objectEspDistance", 500)
		S.objectRubles=valueOf(t, "objectRubles", false)
		S.trackedLootEnabled={}
		if type(t.trackedLootEnabled) == "table" then
			for name, enabled in pairs(t.trackedLootEnabled) do
				if TRACKED_LOOT_NAMES[name] and type(enabled) == "boolean" then
					S.trackedLootEnabled[name] = enabled
				end
			end
		end
		S.freeCamSpeed=valueOf(t, "freeCamSpeed", 50)

		S.fullbright=t.fullbright or false; S.noFog=t.noFog or false
		S.dismissKey = Enum.KeyCode[t.dismissKeyName or "Semicolon"] or Enum.KeyCode.Semicolon

		S.baseFov=valueOf(t, "baseFov", 70); S.zoomFov=valueOf(t, "zoomFov", 30)
		S.zoomKey = Enum.KeyCode[t.zoomKeyName or "Z"] or Enum.KeyCode.Z

		S.vmEnabled=t.vmEnabled or false; S.vmTransparency=t.vmTransparency or 0
		S.vmOffsetX=t.vmOffsetX or 0; S.vmOffsetY=t.vmOffsetY or 0; S.vmOffsetZ=t.vmOffsetZ or 0
		S.vmColor = Color3.new(valueOf(t, "vmColorR", 0.31), valueOf(t, "vmColorG", 0.61), valueOf(t, "vmColorB", 0.47))

		S.wpnEnabled=t.wpnEnabled or false; S.wpnTransparency=t.wpnTransparency or 0
		S.wpnColor = Color3.new(valueOf(t, "wpnColorR", 1), valueOf(t, "wpnColorG", 1), valueOf(t, "wpnColorB", 1))

		if type(t.colors) == "table" then
			for name, rgb in pairs(t.colors) do
				if C[name] and type(rgb) == "table" and #rgb == 3 then
					C[name] = Color3.new(rgb[1], rgb[2], rgb[3])
				end
			end
		end

		S.invEnabled=t.invEnabled or false
		S.invKey = Enum.KeyCode[t.invKeyName or "X"] or Enum.KeyCode.X
		S.invShowName=true; S.invShowValue=true; S.invShowFull=true
		S.invIncludeCorpse=true; S.invMaxAngleDeg=30; S.invMaxDistance=1000000000
		S.invShowAttach=true
		S.objectSearchScope=t.objectSearchScope or "All Loot"
		if S.objectSearchScope == "All Workspace" then S.objectSearchScope = "All Loot" end
		S.objectSearchMarker=t.objectSearchMarker or "Name"

		Aimbot.stop()
		if S.aimEnabled then Aimbot.start() end
		ESP.stopESP(); ESP.stopSkeleton(); ESP.stopTracer()
		if S.espBox then ESP.startESP() end
		if S.espSkeleton then ESP.startSkeleton() end
		if S.espTracer then ESP.startTracer() end
		NPCEsp.stopESP(); NPCEsp.stopSkeleton(); NPCEsp.stopTracer()
		if S.npcEspBox then NPCEsp.startESP() end
		if S.npcEspSkeleton then NPCEsp.startSkeleton() end
		if S.npcEspTracer then NPCEsp.startTracer() end
		GroundESP.setGroundItems(S.groundItemEsp)
		GroundESP.setCorpses(S.corpseEsp)
		GroundESP.setMinValue(S.groundMinValue)
		ObjectESP.setEnabled(S.objectEsp)
		ObjectESP.setCategory("ammo", S.objectAmmo); ObjectESP.setCategory("weapon", S.objectWeapons)
		ObjectESP.setCategory("misc", S.objectMisc); ObjectESP.setCategory("tool", S.objectTools)
		ObjectESP.setCategory("medical", S.objectMedical); ObjectESP.setCategory("armor", S.objectArmor); ObjectESP.setCategory("food", S.objectFood); ObjectESP.setCategory("key", S.objectKeys); ObjectESP.setCategory("attachment", S.objectAttachments); ObjectESP.setDistance(S.objectEspDistance)
		ObjectESP.setCategory("currency", S.objectRubles)
		refreshTrackedLootUI()
		PlayerList.setEnabled(S.playerList)
		Glow.setPlayerGlow(S.playerGlow); Glow.setNpcGlow(S.npcGlow)
		Footsteps.setEnabled(S.footsteps)
		World.setFullbright(S.fullbright); World.setNoFog(S.noFog)
		VM.setVMEnabled(S.vmEnabled); VM.setWpnEnabled(S.wpnEnabled)
		Inventory.setEnabled(S.invEnabled)
		Freecam.setSpeed(S.freeCamSpeed)
		-- A profile restores settings, never an active scripted camera state.
		Freecam.stop()
		syncToggleControls()
	end

	function self.save(slot)
		local name = "slot" .. tostring(slot)
		local data = self.collect()
		local ok = SaveFile(name, HttpService:JSONEncode(data))
		print("[Config] SAVE slot" .. slot .. (ok and " (local file)" or " failed"))
		showConfigStatus(ok and ("Settings saved locally to Slot " .. slot) or "Could not save Slot " .. slot)
		return ok
	end

	function self.load(slot)
		local name = "slot" .. tostring(slot)
		local data = nil
		local raw = LoadFile(name)
		if raw then
			local ok, dec = pcall(function() return HttpService:JSONDecode(raw) end)
			if ok and type(dec) == "table" then data = dec end
		end
		if not data then
			warn("[Config] slot" .. slot .. " empty")
			showConfigStatus("Slot " .. slot .. " is empty")
			return false
		end
		self.apply(data)
		print("[Config] LOAD slot" .. slot)
		showConfigStatus("Settings loaded from Slot " .. slot)
		return true
	end

	function self.saveDefault()
		local data = self.collect()
		local ok = SaveFile("default", HttpService:JSONEncode(data))
		showConfigStatus(ok and "Default configuration saved" or "Could not save default configuration")
		return ok
	end

	function self.loadDefault()
		local raw = LoadFile("default")
		local data = nil
		if raw then
			local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
			if ok and type(decoded) == "table" then data = decoded end
		end
		if not data then showConfigStatus("Default configuration is empty"); return false end
		self.apply(data)
		showConfigStatus("Default configuration loaded")
		return true
	end

	return self
end)()

