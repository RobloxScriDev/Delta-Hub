refreshObjectSearch = function()
	for _, child in ipairs(objectGrid:GetChildren()) do
		if child:GetAttribute("ObjectSearchRow") then child:Destroy() end
	end
	local results, total, errorText = WorldSearch.search(objectSearchInput and objectSearchInput.Text, S.objectSearchScope)
	if errorText then
		objectSearchStatus.Text = errorText
		objectSearchStatus.TextColor3 = THEME.textDim
		return
	end
	objectSearchStatus.Text = string.format("%d match%s in %s — all results shown.", total, total == 1 and "" or "es", S.objectSearchScope)
	objectSearchStatus.TextColor3 = total > 0 and THEME.success or THEME.textDim
	for index, result in ipairs(results) do
		local row = Instance.new("TextButton", objectGrid)
		row.BackgroundColor3 = THEME.card
		row.BorderSizePixel = 0
		row.AutoButtonColor = false
		local distance = result.distance and string.format("  •  %.0f m", result.distance) or ""
		row.Text = string.format("%s\n%s%s", result.lootName or result.instance.Name, result.location or result.instance.ClassName, distance)
		row.TextColor3 = THEME.text
		row.Font = Enum.Font.GothamMedium
		row.TextSize = 12
		row.TextXAlignment = Enum.TextXAlignment.Left; row.TextYAlignment = Enum.TextYAlignment.Center
		row.TextWrapped = true; row.LayoutOrder = index
		row:SetAttribute("ObjectSearchRow", true)
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
		local padding = Instance.new("UIPadding", row)
		padding.PaddingLeft = UDim.new(0, 12)
		padding.PaddingRight = UDim.new(0, 12)
		row.MouseEnter:Connect(function() row.BackgroundColor3 = THEME.cardHover end)
		row.MouseLeave:Connect(function() row.BackgroundColor3 = THEME.card end)
		row.MouseButton1Click:Connect(function()
			WorldSearch.focus(result.instance, S.objectSearchMarker)
			objectSearchStatus.Text = "Marked: " .. result.instance:GetFullName() .. " (clear it when finished)"
			objectSearchStatus.TextColor3 = THEME.accent
		end)
	end
end

addButton("Search Map", THEME.accent, refreshObjectSearch)
addButton("Clear Object Highlight", THEME.card, function()
	WorldSearch.clearFocus()
	objectSearchStatus.Text = "Object highlight cleared."
	objectSearchStatus.TextColor3 = THEME.textDim
end)

