-- ============================================================
-- INPUT
-- ============================================================
UserInputService.InputBegan:Connect(function(input, gp)
	if hubDestroyed then return end
	if pendingKeybind then
		local ok = pendingKeybind(input)
		if ok then
			pendingKeybind = nil
			return
		end
	end

	if gp then return end

	if H.matchesHold(input) then
		if S.aimActivationMode == "Toggle" then
			isHolding = not isHolding
		else
			isHolding = true
		end
	end
	if input.KeyCode == S.invKey then isHoldingInv = true end

	if input.KeyCode == S.dismissKey then
		setMenuVisible(not menuOpen)
	end
end)

UserInputService.InputEnded:Connect(function(input, gp)
	if hubDestroyed then return end
	if S.aimActivationMode == "Hold" and H.matchesHold(input) then
		isHolding = false
	end
	if input.KeyCode == S.invKey then
		isHoldingInv = false
	end
end)

-- Respawn
Players.PlayerAdded:Connect(function(plr)
	if plr == LocalPlayer then return end
	plr.CharacterAdded:Connect(function(char)
		if S.playerGlow then Glow.applyToModel(char) end
		ESP.refresh()
	end)
	if S.playerGlow and plr.Character then Glow.applyToModel(plr.Character) end
	ESP.refresh()
end)
Players.PlayerRemoving:Connect(function(plr)
	ESP.clearESP(plr); ESP.clearSkeleton(plr); ESP.clearTracer(plr)
	if plr.Character then Glow.removeFromModel(plr.Character) end
end)
LocalPlayer.CharacterAdded:Connect(function()
	ESP.restartAll()
end)

