local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Camera      = workspace.CurrentCamera
local Workspace   = workspace
local Shared      = (getgenv and getgenv()) or _G

if Shared.DeltaHubCleanup then pcall(Shared.DeltaHubCleanup) end
Shared.DeltaHubCleanup = nil

local Inventory

for _, name in ipairs({"CleanCheats", "InventoryHUD", "PlayerList"}) do
	local old = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild(name)
	if old then old:Destroy() end
end

local C = {
	ESP          = Color3.fromRGB(0, 255, 80),
	SKELETON     = Color3.fromRGB(255, 255, 255),
	TRACER       = Color3.fromRGB(70, 220, 100),
	TRACER_HIDDEN = Color3.fromRGB(235, 70, 70),
	TRACER_TARGETING = Color3.fromRGB(255, 220, 60),
	AIM_FOV      = Color3.fromRGB(255, 255, 255),
	GLOW         = Color3.fromRGB(255, 255, 0),
	FOOTSTEP     = Color3.fromRGB(255, 100, 0),
	NPC_ESP      = Color3.fromRGB(0, 255, 80),
	NPC_SKELETON = Color3.fromRGB(255, 255, 255),
	NPC_TRACER   = Color3.fromRGB(0, 180, 255),
	GROUND_ITEM  = Color3.fromRGB(255, 205, 70),
	CONTAINER    = Color3.fromRGB(120, 200, 255),
	CORPSE       = Color3.fromRGB(205, 110, 255),
	VM_COLOR     = Color3.fromRGB(79, 155, 121),
	WPN_COLOR    = Color3.fromRGB(255, 255, 255),
}

local S = {
	aimEnabled=false, aimMode="Lock", aimPart="Head", aimFov=90,
	aimSmoothing=0.3, aimPrediction=0, aimVisibleOnly=false,
	aimNPCs=false,
	weaponPrediction=false, weaponAntiRecoil=false, weaponRecoilStrength=1, weaponDropScale=0.05,
	holdKey={type="key", code=Enum.KeyCode.F}, aimActivationMode="Toggle",
	perfectSilent=false, silentHitChance=100,

	espBox=false, espSkeleton=false, espTracer=false,
	espShowHeldItem=false, espShowAiming=false,
	npcEspBox=false, npcEspSkeleton=false, npcEspTracer=false,

	playerGlow=false, npcGlow=false, glowTransparency=0.5,

	footsteps=false, footstepSize=4,

	playerList=false,
	groundItemEsp=false, corpseEsp=false, containerContentsEsp=true, groundMinValue=0,
	objectEsp=false, objectAmmo=false, objectWeapons=false, objectMisc=false, objectTools=false,
	objectMedical=false, objectArmor=false, objectFood=false, objectKeys=false, objectAttachments=false,
	objectEspDistance=500,
	objectRubles=false,
	trackedLootEnabled={},

	freeCam=false, freeCamSpeed=50,

	fullbright=false, noFog=false,
	dismissKey=Enum.KeyCode.Semicolon,

	baseFov=70, zoomFov=30, zoomKey=Enum.KeyCode.Z,

	vmEnabled=false, vmTransparency=0,
	vmOffsetX=0, vmOffsetY=0, vmOffsetZ=0,
	vmColor=Color3.fromRGB(79,155,121),

	wpnEnabled=false, wpnTransparency=0, wpnColor=Color3.new(1,1,1),

	invEnabled=false, invKey=Enum.KeyCode.X,
	invShowName=true, invShowValue=true, invShowFull=true,
	invIncludeCorpse=true, invMaxAngleDeg=30, invMaxDistance=1000000000,
	invShowAttach=true,
	objectSearchScope="All Loot",
	objectSearchMarker="Name",
}

-- Exact internal names confirmed by the inventory scan.  These are always
-- shown by the unified loot ESP, even when the game has no price metadata.
local TRACKED_LOOT = {
	"AirfieldTunnelsKey", "BlueCard", "CatToken", "CraneKey", "DormB203Key", "EVACKey",
	"FactoryGarageKey", "FuelingStationKey", "LighthouseKey", "M4", "OrangeCard", "SPSh44",
	"SwampKey", "Villa1Key", "VillageKey", "KeyChain",
}
local TRACKED_LOOT_NAMES = {}
for _, name in ipairs(TRACKED_LOOT) do TRACKED_LOOT_NAMES[string.lower(name)] = true end
local function isTrackedLoot(name)
	local key = string.lower(name)
	return TRACKED_LOOT_NAMES[key] == true and S.trackedLootEnabled[key] ~= false
end

local isHolding        = false
local isHoldingInv     = false
local menuOpen         = true
