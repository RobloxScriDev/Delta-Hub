local trackedGrid = Instance.new("ScrollingFrame", getCurrentContainer())
trackedGrid.Size = UDim2.new(1, -6, 0, 145)
trackedGrid.BackgroundColor3 = THEME.card
trackedGrid.BorderSizePixel = 0
trackedGrid.ScrollBarThickness = 5
trackedGrid.ScrollBarImageColor3 = THEME.accent
trackedGrid.CanvasSize = UDim2.new()
trackedGrid.AutomaticCanvasSize = Enum.AutomaticSize.Y
trackedGrid.LayoutOrder = #getCurrentContainer():GetChildren() + 1
Instance.new("UICorner", trackedGrid).CornerRadius = UDim.new(0, 6)
local trackedPadding = Instance.new("UIPadding", trackedGrid)
trackedPadding.PaddingTop = UDim.new(0, 6); trackedPadding.PaddingBottom = UDim.new(0, 6)
trackedPadding.PaddingLeft = UDim.new(0, 6); trackedPadding.PaddingRight = UDim.new(0, 6)
local trackedLayout = Instance.new("UIGridLayout", trackedGrid)
trackedLayout.CellSize = UDim2.new(1/3, -5, 0, 32)
trackedLayout.CellPadding = UDim2.new(0, 5, 0, 5)
trackedLayout.SortOrder = Enum.SortOrder.LayoutOrder
local trackedCells = {}
for index, itemName in ipairs(TRACKED_LOOT) do
	local key = string.lower(itemName)
	local cell = Instance.new("TextButton", trackedGrid)
	cell.BackgroundColor3 = THEME.cardHover; cell.BorderSizePixel = 0
	cell.AutoButtonColor = false; cell.Text = ""; cell.LayoutOrder = index
	Instance.new("UICorner", cell).CornerRadius = UDim.new(0, 5)
	local box = Instance.new("Frame", cell)
	box.Size = UDim2.new(0, 14, 0, 14); box.Position = UDim2.new(0, 6, 0.5, -7)
	box.BackgroundColor3 = Color3.fromRGB(49, 65, 91); box.BorderSizePixel = 0
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 3)
	local fill = Instance.new("Frame", box)
	fill.Size = UDim2.new(1, -4, 1, -4); fill.Position = UDim2.new(0, 2, 0, 2)
	fill.BackgroundColor3 = THEME.success; fill.BorderSizePixel = 0
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 2)
	local label = Instance.new("TextLabel", cell)
	label.Size = UDim2.new(1, -27, 1, 0); label.Position = UDim2.new(0, 24, 0, 0)
	label.BackgroundTransparency = 1; label.Text = itemName; label.TextColor3 = THEME.text
	label.Font = Enum.Font.GothamMedium; label.TextSize = 10
	label.TextXAlignment = Enum.TextXAlignment.Left; label.TextTruncate = Enum.TextTruncate.AtEnd
	trackedCells[key] = {cell=cell, fill=fill, label=label}
	cell.MouseButton1Click:Connect(function()
		S.trackedLootEnabled[key] = S.trackedLootEnabled[key] == false
		refreshTrackedLootUI()
		GroundESP.refresh()
	end)
end
refreshTrackedLootUI = function()
	for key, data in pairs(trackedCells) do
		local enabled = S.trackedLootEnabled[key] ~= false
		data.fill.Visible = enabled
		data.cell.BackgroundColor3 = enabled and THEME.cardHover or THEME.card
		data.label.TextColor3 = enabled and THEME.text or THEME.textDim
	end
end
refreshTrackedLootUI()

